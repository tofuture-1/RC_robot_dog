rotocol_Status;\n67\t} Struct_CAN_Status;\n68\t\n69\t/**\n70\t * @brief CAN 管理对象，用于统一维护句柄、接收缓存、回调函数及运行状态。\n71\t */\n72\ttypedef struct\n73\t{\n74\t    CAN_HandleTypeDef *CAN_Handler;\n75\t    Struct_CAN_Rx_Buffer Rx_Buffer;\n76\t    CAN_Call_Back Callback_Function;\n77\t    Struct_CAN_Status Status;\n78\t} Struct_CAN_Manage_Object;\n79\t\n80\textern Struct_CAN_Manage_Object CAN1_Manage_Object;\n81\textern Struct_CAN_Manage_Object CAN2_Manage_Object;\n82\t\n83\t/**\n84\t * @brief 初始化指定的 CAN 外设，并注册对应的接收回调函数。\n85\t * @param hcan CAN 外设句柄指针，用于指定待初始化的硬件实例。\n86\t * @param Callback_Function 接收完成后的回调函数指针，可为上层模块提供报文处理入口。\n87\t */\n88\tvoid CAN_Init(CAN_HandleTypeDef *hcan, CAN_Call_Back Callback_Function);\n89\t\n90\t/**\n91\t * @brief 通过指定的 CAN 外设发送一帧标准数据报文。\n92\t * @param hcan CAN 外设句柄指针，用于指定发送使用的硬件实例。\n93\t * @param ID 标准帧标识符。\n94\t * @param Data 待发送的数据缓冲区指针。\n95\t * @param Length 待发送的数据长度，需与 HAL 定义的 DLC 长度配置保持一致。\n96\t * @return HAL_StatusTypeDef 返回 HAL 层发送结果。\n97\t */\n98\tHAL_StatusTypeDef CAN_Send_Data(CAN_HandleTypeDef *hcan, uint16_t ID, uint8_t *Data, uint8_t Length);\n99\t\n100\t/**\n101\t * @brief 立即发送一帧 CAN 数据报文，并在发送失败时返回明确的状态结果。\n102\t * @param hcan CAN 外设句柄指针，用于指定发送使用的硬件实例。\n103\t * @param ID 标准帧标识符。\n104\t * @param Data 待发送的数据缓冲区指针。\n105\t * @param Length 待发送的数据长度，需与 HAL 定义的 DLC 长度配置保持一致。\n106\t * @return HAL_StatusTypeDef 返回实时发送结果，发送异常时通常返回 HAL_ERROR。\n107\t */\n108\tHAL_StatusTypeDef CAN_Send_Data_Realtime(CAN_HandleTypeDef *hcan, uint16_t ID, uint8_t *Data, uint8_t Length);\n109\t\n110\t/**\n111\t * @brief 更新指定 CAN 外设的总线运行状态，并刷新错误统计信息。\n112\t * @param hcan CAN 外设句柄指针，用于指定待更新状态的硬件实例。\n113\t */\n114\tvoid CAN_Update_Bus_Status(CAN_HandleTypeDef *hcan);\n115\t\n116\t/**\n117\t * @brief 获取指定 CAN 外设对应的状态统计结构体指针。\n118\t * @param hcan CAN 外设句柄指针，用于匹配对应的管理对象。\n119\t * @return Struct_CAN_Status* 返回状态结构体指针，未匹配到时返回空指针。\n120\t */\n121\tStruct_CAN_Status *CAN_Get_Status(CAN_HandleTypeDef *hcan);\n122\t\n123\t/**\n124\t * @brief CAN 电机控制 1ms 周期任务回调函数，用于执行周期性报文处理。\n125\t