                    "text": "1\t//\n2\t// Created by 24158 on 2026/6/8.\n3\t//\n4\t\n5\t#include \"drv_can.h\"\n6\t//#include \"stm32F4xx_hal_can.h\"//虽然drv_can.h中包含了该项，但显式包含可提高代码可读性及稳定性，重复包含留给编译器自行处理\n7\t\n8\t//#include \"string.h\"\n9\t\n10\tbool init_finished = false;\n11\t\n12\tStruct_CAN_Manage_Object CAN1_Manage_Object = {0};\n13\tStruct_CAN_Manage_Object CAN2_Manage_Object = {0};\n14\t\n15\t\n16\t\n17\t// �������ݷ��ͻ���\n18\tuint8_t CAN_Supercap_Tx_Data[8];\n19\t\n20\t/*-----------------˽�б�������-----------------*/\n21\t// CAN1 ���ͻ���\n22\tuint8_t CAN1_0x1fe_Tx_Data[8] = {0};\n23\tuint8_t CAN1_0x1ff_Tx_Data[8] = {0};\n24\tuint8_t CAN1_0x200_Tx_Data[8] = {0};\n25\tuint8_t CAN1_0x2fe_Tx_Data[8] = {0};\n26\tuint8_t CAN1_0x2ff_Tx_Data[8] = {0};\n27\tuint8_t CAN1_0x3fe_Tx_Data[8] = {0};\n28\tuint8_t CAN1_0x4fe_Tx_Data[8] = {0};\n29\t\n30\t// CAN2 ���ͻ���\n31\tuint8_t CAN2_0x1fe_Tx_Data[8] = {0};\n32\tuint8_t CAN2_0x1ff_Tx_Data[8] = {0};\n33\tuint8_t CAN2_0x200_Tx_Data[8] = {0};\n34\tuint8_t CAN2_0x2fe_Tx_Data[8] = {0};\n35\tuint8_t CAN2_0x2ff_Tx_Data[8] = {0};\n36\tuint8_t CAN2_0x3fe_Tx_Data[8] = {0};\n37\tuint8_t CAN2_0x4fe_Tx_Data[8] = {0};\n38\t\n39\t/**\n40\t * @brief ���� CAN �����ȡ��Ӧ�Ĺ�������\n41\t * @param hcan CAN ������ָ�룬����ƥ������ CAN ʵ����\n42\t * @return Struct_CAN_Manage_Object* ����ƥ�䵽�Ĺ�������ָ�룬δƥ�䵽ʱ���ؿ�ָ�롣\n43\t */\n44\tstatic Struct_CAN_Manage_Object *CAN_Get_Manage_Object(\n45\t    CAN_HandleTypeDef *hcan) {\n46\t  if (hcan == nullptr) {\n47\t    return nullptr;\n48\t  }\n49\t\n50\t  if (hcan->Instance == CAN1) {\n51\t    return &CAN1_Manage_Object;\n52\t  } else if (hcan->Instance == CAN2) {\n53\t    return &CAN2_Manage_Object;\n54\t  }\n55\t\n56\t  return nullptr;\n57\t}\n58\t\n59\t/**\n60\t * @brief ����ָ�����������е�״̬ͳ����Ϣ��\n61\t * @param manage_object CAN ��������ָ�룬����ָ���������״̬��¼��\n62\t */\n63\tstatic void CAN_Reset_Status(Struct_CAN_Manage_Object *manage_object) {\n64\t  if (manage_object == nullptr) {\n65\t    return;\n66\t  }\n67\t\n68\t  // ֱ�����״̬ͳ�ƽṹ�壬���������ʷ״̬��\n69\t  memset(&manage_object->Status, 0, sizeof(manage_object->Status));\n70\t}\n71\t\n72\t/**\n73\t * @brief ���·��ͽ��ͳ����Ϣ������¼���η���ʱ�� FIFO ������ȡ�\n74\t * @param manage_object CAN ��������ָ�룬���ڱ��淢��ͳ�ƽ����\n75\t * @param send_status ���η��ͽӿڷ��ص� HAL ״ֵ̬��\n76\t * @param tx_free_level ����ǰ��ȡ���� Tx FIFO ������ȡ�\n77\t */\n78\tstatic void CAN_Update_Tx_Status(Struct_CAN_Manage_Object *manage_object,\n79\t                                   HAL_StatusTypeDef send_status,\n80\t                                   uint32_t tx_free_level) {\n81\t  if (manage_object == nullptr) {\n82\t    return;\n83\t  }\n84\t\n85\t  manage_object->Status.Last_Tx_Free_Level = tx_free_level;\n86\t\n87\t  if (send_status == HAL_OK) {\n88\t    manage_object->Status.Tx_Success_Count++;\n89\t    manage_object->Status.Tx_Consecutive_Fail_Count = 0;\n90\t  } else {\n91\t    manage_object->Status.Tx_Fail_Count++;\n92\t    manage_object->Status.Tx_Consecutive_Fail_Count++;\n93\t\n94\t    if (tx_free_level == 0U) {\n95\t      manage_object->Status.Tx_Fifo_Full_Count++;//邮箱已满计数\n96\t    }\n97\t  }\n98\t}\n99\t\n100\t/**\n101\t * @brief ��ʼ��ָ�� CAN ʵ�����˲�����֪ͨ�͹���������Ϣ��\n102\t * @param hcan CAN ������ָ�룬����ָ������ʼ����Ӳ��ʵ����\n103\t * @param Callback_Function ���ջص�����ָ�룬���ڱ��Ľ��պ���ϲ㴦����\n104\t */\n105\t// F407 BXCAN 初始化流程\n106\tvoid CAN_Init(CAN_HandleTypeDef *hcan, CAN_Call_Back Callback_Function) {\n107\t    // ===== 1. 配置滤波器1（掩码过滤 0x200-0x20F → FIFO0）=====\n108\t    CAN_FilterTypeDef CAN_FilterConfig1 = {0};\n109\t\n110\t    // bxCAN 滤波器配置（32位掩码模式）\n111\t    CAN_FilterConfig1.FilterBank = 0;                       // 使用滤波器组 0\n112\t    CAN_FilterConfig1.FilterMode = CAN_FILTERMODE_IDMASK;    // 掩码模式\n113\t    CAN_FilterConfig1.FilterScale = CAN_FILTERSCALE_32BIT;   // 32位宽\n114\t    CAN_FilterConfig1.FilterIdHigh = 0x200 << 5;            // 标准ID左移5位\n115\t  // CAN_FilterConfig1.FilterIdHigh = 0x000 << 5;            // 匹配所有ID\n116\t    CAN_FilterConfig1.FilterIdLow = 0x0000;\n117\t    CAN_FilterConfig1.FilterMaskIdHigh = 0x7F0 << 5;        // 掩码（匹配高7位）\n118\t  // CAN_FilterConfig1.FilterMaskIdHigh = 0x000 << 5;        // 掩码全0（匹配所有）\n119\t    CAN_FilterConfig1.FilterMaskIdLow = 0x0000;\n120\t    CAN_FilterConfig1.FilterFIFOAssignment = CAN_RX_FIFO0;  // 匹配后送入FIFO0\n121\t    CAN_FilterConfig1.FilterActivation = ENABLE;             // 启用滤波器\n122\t    CAN_FilterConfig1.SlaveStartFilterBank = 14;             // CAN2从14号滤波器开始\n123\t\n124\t    HAL_CAN_ConfigFilter(hcan, &CAN_FilterConfig1);\n125\t\n126\t    // ===== 2. 配置滤波器2（接收所有标准帧 → FIFO1）=====\n127\t    CAN_FilterTypeDef CAN_FilterConfig2 = {0};\n128\t\n129\t    CAN_FilterConfig2.FilterBank = 1;                       // 使用滤波器组 1\n130\t    CAN_FilterConfig2.FilterMode = CAN_FILTERMODE_IDMASK;\n131\t    CAN_FilterConfig2.FilterScale = CAN_FILTERSCALE_32BIT;\n132\t    CAN_FilterConfig2.FilterIdHigh = 0x000 << 5;            // 匹配所有ID\n133\t    CAN_FilterConfig2.FilterIdLow = 0x0000;\n134\t    CAN_FilterConfig2.FilterMaskIdHigh = 0x000 << 5;        // 掩码全0（匹配所有）\n135\t    CAN_FilterConfig2.FilterMaskIdLow = 0x0000;\n136\t    CAN_FilterConfig2.FilterFIFOAssignment = CAN_RX_FIFO1;  // 送入FIFO1\n137\t    CAN_FilterConfig2.FilterActivation = ENABLE;\n138\t\n139\t    HAL_CAN_ConfigFilter(hcan, &CAN_FilterConfig2);\n140\t\n141\t    // ===== 3. 配置管理对象 =====\n142\t    Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n143\t    if (manage_object != nullptr) {\n144\t        manage_object->CAN_Handler = hcan;\n145\t        manage_object->Callback_Function = Callback_Function;\n146\t        CAN_Reset_Status(manage_object);\n147\t    }\n148\t\n149\t    // ===== 4. 激活中断通知 =====\n150\t    HAL_CAN_ActivateNotification(hcan,\n151\t        CAN_IT_RX_FIFO0_MSG_PENDING |    // FIFO0有新消息\n152\t        CAN_IT_RX_FIFO1_MSG_PENDING |    // FIFO1有新消息\n153\t        CAN_IT_ERROR_WARNING |           // 错误警告\n154\t        CAN_IT_ERROR_PASSIVE |           // 被动错误\n155\t        CAN_IT_BUSOFF | CAN_IT_TX_MAILBOX_EMPTY);                 // 总线关闭及发送邮箱空（启动tx中断）\n156\t\n157\t    // ===== 5. 启动 CAN =====\n158\t    HAL_CAN_Start(hcan);\n159\t    CAN_Update_Bus_Status(hcan);\n160\t}\n161\t\n162\t/**\n163\t * @brief ͨ��ָ�� CAN ʵ������һ֡���ݣ������·���ͳ��״̬��\n164\t * @param hcan CAN ������ָ�룬����ָ������ʹ�õ�Ӳ��ʵ����\n165\t * @param ID ��׼֡��ʶ����\n166\t * @param Data ���������ݻ�����ָ�롣\n167\t * @param Length ���� DLC ��������ֵ��\n168\t * @return HAL_StatusTypeDef ���� HAL �㷢�ͽ����\n169\t */\n170\tHAL_StatusTypeDef CAN_Send_Data(CAN_HandleTypeDef *hcan, uint16_t ID,\n171\t                                  uint8_t *Data, uint8_t Length) {\n172\t  CAN_TxHeaderTypeDef TxHeader;\n173\t\n174\t  TxHeader.StdId = ID;\n175\t  TxHeader.ExtId = 0;\n176\t  TxHeader.IDE = CAN_ID_STD;\n177\t  TxHeader.RTR = CAN_RTR_DATA;\n178\t  TxHeader.DLC = Length;\n179\t  TxHeader.TransmitGlobalTime = DISABLE;\n180\t\n181\t  Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n182\t  uint32_t tx_mailbox;\n183\t  HAL_StatusTypeDef send_status;\n184\t  uint32_t retry_cnt = 200U;  // 重试上限约 2ms（@1Mbps 一帧约 111μs）\n185\t\n186\t  do {\n187\t    send_status = HAL_CAN_AddTxMessage(hcan, &TxHeader, Data, &tx_mailbox);\n188\t    if (send_status != HAL_OK) {\n189\t      /* 所有 3 个邮箱均已满，等待 TX 中断释放其中一个邮箱 */\n190\t      for (volatile uint32_t i = 0U; i < 500U; i++) { }\n191\t      retry_cnt--;\n192\t    }\n193\t  } while ((send_status != HAL_OK) && (retry_cnt > 0U));\n194\t\n195\t  uint32_t tx_free_level = HAL_CAN_GetTxMailboxesFreeLevel(hcan);\n196\t  CAN_Update_Tx_Status(manage_object, send_status, tx_free_level);\n197\t  if (send_status != HAL_OK) {\n198\t    CAN_Update_Bus_Status(hcan);\n199\t  }\n200\t\n201\t  return send_status;\n202\t}\n203\t\n204\t/**\n205\t * @brief ��ʵʱ��ʽ���ͱ��ģ������� FIFO ����ʱֱ�ӷ���ʧ�ܡ�\n206\t * @param hcan CAN ������ָ�룬����ָ������ʹ�õ�Ӳ��ʵ����\n207\t * @param ID ��׼֡��ʶ����\n208\t * @param Data ���������ݻ�����ָ�롣\n209\t * @param Length ���� DLC ��������ֵ��\n210\t * @return HAL_StatusTypeDef ����ʵʱ���ͽ����\n211\t */\n212\tHAL_StatusTypeDef CAN_Send_Data_Realtime(CAN_HandleTypeDef *hcan,\n213\t                                           uint16_t ID, uint8_t *Data,\n214\t                                           uint8_t Length) {\n215\t  uint32_t tx_free_level = HAL_CAN_GetTxMailboxesFreeLevel(hcan);\n216\t  if (tx_free_level == 0U) {\n217\t    CAN_Update_Tx_Status(CAN_Get_Manage_Object(hcan), HAL_ERROR,\n218\t                           tx_free_level);\n219\t    CAN_Update_Bus_Status(hcan);\n220\t    return HAL_ERROR;\n221\t  }\n222\t\n223\t  return CAN_Send_Data(hcan, ID, Data, Length);\n224\t}\n225\t\n226\t/**\n227\t * @brief ˢ��ָ�� CAN ʵ����Э��״̬������״̬�� FIFO ������ȡ�\n228\t * @param hcan CAN ������ָ�룬����ָ��������״̬��Ӳ��ʵ����\n229\t */\n230\tvoid CAN_Update_Bus_Status(CAN_HandleTypeDef *hcan) {\n231\t  Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n232\t  if (manage_object == nullptr) {\n233\t    return;\n234\t  }\n235\t\n236\t  // BXCAN 通过直接读取 CAN 控制器寄存器获取协议状态\n237\t  manage_object->Status.Last_Protocol_Status = 0U;\n238\t  \n239\t  // 读取 CAN 控制器状态寄存器\n240\t  uint32_t msr = hcan->Instance->MSR;  // 模式状态寄存器\n241\t  uint32_t esr = hcan->Instance->ESR;  // 错误状态寄存器\n242\t  \n243\t  // bit[0:2]: 最后错误代码 (LEC)\n244\t  manage_object->Status.Last_Protocol_Status |= (esr & 0x7U);\n245\t  \n246\t  // bit[3:5]: 数据段最后错误代码 (BXCAN不支持，设为0)\n247\t  manage_object->Status.Last_Protocol_Status |= (0U << 3);\n248\t  \n249\t  // bit[6:7]: 总线活动状态\n250\t  manage_object->Status.Last_Protocol_Status |= ((((msr >> 1) & 0x1U)) << 6);\n251\t  manage_object->Status.Last_Protocol_Status |= ((((msr >> 0) & 0x1U)) << 7);\n252\t  \n253\t  // bit[8]: 错误被动状态 (EP)\n254\t  manage_object->Status.Last_Protocol_Status |= ((((esr >> 4) & 0x1U)) << 8);\n255\t  \n256\t  // bit[9]: 警告状态 (EWGF)\n257\t  manage_object->Status.Last_Protocol_Status |= ((((esr >> 2) & 0x1U)) << 9);\n258\t  \n259\t  // bit[10]: 总线关闭状态 (BS)\n260\t  manage_object->Status.Last_Protocol_Status |= ((((msr >> 2) & 0x1U)) << 10);\n261\t\n262\t  manage_object->Status.Last_Error_Status = HAL_CAN_GetError(hcan);\n263\t  manage_object->Status.Last_Tx_Free_Level =\n264\t      HAL_CAN_GetTxMailboxesFreeLevel(hcan);\n265\t}\n266\t\n267\t/**\n268\t * @brief 获取指定 CAN 外设对应的状态统计结构体指针。\n269\t * @param hcan CAN 外设句柄指针，用于匹配对应的管理对象。\n270\t * @return Struct_CAN_Status* 返回状态结构体指针，未匹配到时返回空指针。\n271\t */\n272\tStruct_CAN_Status *CAN_Get_Status(CAN_HandleTypeDef *hcan) {\n273\t    Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n274\t    if (manage_object == nullptr) {\n275\t        return nullptr;\n276\t    }\n277\t    return &manage_object->Status;\n278\t}\n279\t\n280\t/**\n281\t * @brief CAN ������� 1ms ��������ص��������·������Կ��Ʊ��ġ�\n282\t */\n283\tvoid RTOS_1ms_CAN_Motor_Callback() {\n284\t  // DJI ������Ʊ���\n285\t\n286\t  // ���̵�����Ʊ��ģ�ID ��Ӧ 0x201~0x204��\n287\t  // CAN_Send_Data_Realtime(&hcan1, 0x200, CAN1_0x200_Tx_Data,\n288\t  //                          8U);\n289\t  // ��̨����չ������Ʊ��ģ�ID ��Ӧ 0x205~0x20B��\n290\t  //CAN_Send_Data_Realtime(&hcan1, 0x1ff, CAN1_0x1ff_Tx_Data,\n291\t  //                           CAN_DLC_BYTES_8);\n292\t}\n293\t\n294\t/**\n295\t * @brief CAN FIFO0 �����жϻص������ڶ�ȡ FIFO0 �е��±��Ĳ������ϲ�ص���\n296\t * @param hcan CAN ������ָ�룬���ڱ�ʶ�����жϵ�Ӳ��ʵ����\n297\t * @param RxFifo0ITs FIFO0 �ж�״̬��־��\n298\t */\n299\tvoid HAL_CAN_RxFifo0Callback(CAN_HandleTypeDef *hcan,\n300\t                               uint32_t RxFifo0ITs) {\n301\t\n302\t  if ((RxFifo0ITs & CAN_IT_RX_FIFO0_MSG_PENDING) == RESET)\n303\t    return;\n304\t\n305\t  Struct_CAN_Manage_Object *manager_obj;\n306\t\n307\t  if(hcan->Instance == CAN1)\n308\t   manager_obj = &CAN1_Manage_Object;\n309\t  else if(hcan->Instance == CAN2)\n310\t   manager_obj = &CAN2_Manage_Object;\n311\t  else\n312\t   return;\n313\t\n314\t  HAL_CAN_GetRxMessage(hcan,CAN_RX_FIFO0, &manager_obj->Rx_Buffer.Header, manager_obj->Rx_Buffer.Data);\n315\t\n316\t  if (!init_finished)\n317\t    return;\n318\t  //�ϲ�ص�����\n319\t  if(manager_obj->Callback_Function != nullptr)\n320\t  {\n321\t    manager_obj->Callback_Function(&manager_obj->Rx_Buffer);\n322\t  }\n323\t}\n324\t\n325\t/**\n326\t * @brief CAN FIFO1 �����жϻص������ڶ�ȡ FIFO1 �е��±��Ĳ������ϲ�ص���\n327\t * @param hcan CAN ������ָ�룬���ڱ�ʶ�����жϵ�Ӳ��ʵ����\n328\t * @param RxFifo1ITs FIFO1 �ж�״̬��־��\n329\t */\n330\tvoid HAL_CAN_RxFifo1Callback(CAN_HandleTypeDef *hcan,\n331\t                               uint32_t RxFifo1ITs) {\n332\t\n333\t  if ((RxFifo1ITs & CAN_IT_RX_FIFO1_MSG_PENDING) == RESET)\n334\t    return;\n335\t\n336\t  Struct_CAN_Manage_Object* manager_obj;\n337\t\n338\t  if(hcan->Instance == CAN1)\n339\t   manager_obj = &CAN1_Manage_Object;\n340\t  else if(hcan->Instance == CAN2)\n341\t   manager_obj = &CAN2_Manage_Object;\n342\t  else\n343\t   return;\n344\t\n345\t  HAL_CAN_GetRxMessage(hcan,CAN_RX_FIFO1, &manager_obj->Rx_Buffer.Header, manager_obj->Rx_Buffer.Data);\n346\t  if (!init_finished)\n347\t    return;\n348\t\n349\t  //�ϲ�ص�����\n350\t  if(manager_obj->Callback_Function != nullptr)\n351\t  {\n352\t    manager_obj->Callback_Function(&manager_obj->Rx_Buffer);\n353\t  }\n354\t}\n355\t\n356\t\n357\t/**\n358\t * @brief CAN ����״̬�жϻص������ڼ�¼ Warning��Error Passive �� Bus-Off �¼���ˢ������״̬��\n359\t * @param hcan CAN ������ָ�룬���ڱ�ʶ��������״̬�жϵ�Ӳ��ʵ����\n360\t * @param ErrorStatusITs ����״̬�жϱ�־λ���������� Warning��Error Passive �� Bus-Off �¼���\n361\t */\n362\tvoid HAL_CAN_ErrorStatusCallback(CAN_HandleTypeDef *hcan,\n363\t                                   uint32_t ErrorStatusITs) {\n364\t  Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n365\t  if (manage_object != nullptr) {\n366\t    manage_object->Status.Last_Error_Status = ErrorStatusITs;\n367\t  }\n368\t\n369\t  // Warning �� Error Passive ֻ��״̬���������ڸý׶�ֱ���������ߡ�\n370\t  if ((ErrorStatusITs & (CAN_IT_ERROR_WARNING | CAN_IT_ERROR_PASSIVE)) !=\n371\t      0U) {\n372\t    CAN_Update_Bus_Status(hcan);\n373\t  }\n374\t\n375\t  if ((ErrorStatusITs & CAN_IT_BUSOFF) != 0U) {\n376\t    if (manage_object != nullptr) {\n377\t      manage_object->Status.Bus_Off_Count++;\n378\t    }\n379\t\n380\t    HAL_CAN_Stop(hcan);\n381\t\n382\t    if (HAL_CAN_Start(hcan) == HAL_OK) {\n383\t\n384\t      HAL_CAN_ActivateNotification(hcan,\n385\t                                     CAN_IT_RX_FIFO0_MSG_PENDING |\n386\t                                         CAN_IT_RX_FIFO1_MSG_PENDING |\n387\t                                         CAN_IT_ERROR_WARNING |\n388\t                                         CAN_IT_ERROR_PASSIVE |\n389\t                                         CAN_IT_BUSOFF);\n390\t    }\n391\t  }\n392\t\n393\t  CAN_Update_Bus_Status(hcan);\n394\t}\n395\t\n396\t\n397\t\n398\t\n399\t\n400"
                }
