t  }\n67\t\n68\t  // ֱ�����״̬ͳ�ƽṹ�壬���������ʷ״̬��\n69\t  memset(&manage_object->Status, 0, sizeof(manage_object->Status));\n70\t}\n71\t\n72\t/**\n73\t * @brief ���·��ͽ��ͳ����Ϣ������¼���η���ʱ�� FIFO ������ȡ�\n74\t * @param manage_object CAN ��������ָ�룬���ڱ��淢��ͳ�ƽ����\n75\t * @param send_status ���η��ͽӿڷ��ص� HAL ״ֵ̬��\n76\t * @param tx_free_level ����ǰ��ȡ���� Tx FIFO ������ȡ�\n77\t */\n78\tstatic void CAN_Update_Tx_Status(Struct_CAN_Manage_Object *manage_object,\n79\t                                   HAL_StatusTypeDef send_status,\n80\t                                   uint32_t tx_free_level) {\n81\t  if (manage_object == nullptr) {\n82\t    return;\n83\t  }\n84\t\n85\t  manage_object->Status.Last_Tx_Free_Level = tx_free_level;\n86\t\n87\t  if (send_status == HAL_OK) {\n88\t    manage_object->Status.Tx_Success_Count++;\n89\t    manage_object->Status.Tx_Consecutive_Fail_Count = 0;\n90\t  } else {\n91\t    manage_object->Status.Tx_Fail_Count++;\n92\t    manage_object->Status.Tx_Consecutive_Fail_Count++;\n93\t\n94\t    if (tx_free_level == 0U) {\n95\t      manage_object->Status.Tx_Fifo_Full_Count++;//邮箱已满计数\n96\t    }\n97\t  }\n98\t}\n99\t\n100\t/**\n101\t * @brief ��ʼ��ָ�� CAN ʵ�����˲�����֪ͨ�͹���������Ϣ��\n102\t * @param hcan CAN ������ָ�룬����ָ������ʼ����Ӳ��ʵ����\n103\t * @param Callback_Function ���ջص�����ָ�룬���ڱ��Ľ��պ���ϲ㴦����\n104\t */\n105\t// F407 BXCAN 初始化流程\n106\tvoid CAN_Init(CAN_HandleTypeDef *hcan, CAN_Call_Back Callback_Function) {\n107\t    // ===== 1. 配置滤波器1（掩码过滤 0x200-0x20F → FIFO0）=====\n108\t    CAN_FilterTypeDef CAN_FilterConfig1 = {0};\n109\t\n110\t    // bxCAN 滤波器配置（32位掩码模式）\n111\t    CAN_FilterConfig1.FilterBank = 0;                       // 使用滤波器组 0\n112\t    CAN_FilterConfig1.FilterMode = CAN_FILTERMODE_IDMASK;    // 掩码模式\n113\t    CAN_FilterConfig1.FilterScale = CAN_FILTERSCALE_32BIT;   // 32位宽\n114\t    CAN_FilterConfig1.FilterIdHigh = 0x200 << 5;            // 标准ID左移5位\n115\t    CAN_FilterConfig1.FilterIdLow = 0x0000;\n116\t    CAN_FilterConfig1.FilterMaskIdHigh = 0x7F0 << 5;        // 掩码（匹配高7位）\n117\t    CAN_FilterConfig1.FilterMaskIdLow = 0x0000;\n118\t    CAN_FilterConfig1.FilterFIFOAssignment = CAN_RX_FIFO0;  // 匹配后送入FIFO0\n119\t    CAN_FilterConfig1.FilterActivation = ENABLE;             // 启用滤波器\n120\t    CAN_FilterConfig1.SlaveStartFilterBank = 14;             // CAN2从14号滤波器开始\n121\t\n122\t    HAL_CAN_ConfigFilter(hcan, &CAN_FilterConfig1);\n123\t\n124\t    // ===== 2. 配置滤波器2（接收所有标准帧 → FIFO1）=====\n125\t    CAN_FilterTypeDef CAN_FilterConfig2 = {0};\n126\t\n127\t    CAN_FilterConfig2.FilterBank = 1;                       // 使用滤波器组 1\n128\t    CAN_FilterConfig2.FilterMode = CAN_FILTERMODE_IDMASK;\n129\t    CAN_FilterConfig2.FilterScale = CAN_FILTERSCALE_32BIT;\n130\t    CAN_FilterConfig2.FilterIdHigh = 0x000 << 5;            // 匹配所有ID\n131\t    CAN_FilterConfig2.FilterIdLow = 0x0000;\n132\t    CAN_FilterConfig2.FilterMaskIdHigh = 0x000 << 5;        // 掩码全0（匹配所有）\n133\t    CAN_FilterConfig2.FilterMaskIdLow = 0x0000;\n134\t    CAN_FilterConfig2.FilterFIFOAssignment = CAN_RX_FIFO1;  // 送入FIFO1\n135\t    CAN_FilterConfig2.FilterActivation = ENABLE;\n136\t\n137\t    HAL_CAN_ConfigFilter(hcan, &CAN_FilterConfig2);\n138\t\n139\t    // ===== 3. 配置管理对象 =====\n140\t    Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n141\t    if (manage_object != nullptr) {\n142\t        manage_object->CAN_Handler = hcan;\n143\t        manage_object->Callback_Function = Callback_Function;\n144\t        CAN_Reset_Status(manage_object);\n145\t    }\n146\t\n147\t    // ===== 4. 激活中断通知 =====\n148\t    HAL_CAN_ActivateNotification(hcan,\n149\t        CAN_IT_RX_FIFO0_MSG_PENDING |    // FIFO0有新消息\n150\t        CAN_IT_RX_FIFO1_MSG_PENDING |    // FIFO1有新消息\n151\t        CAN_IT_ERROR_WARNING |           // 错误警告\n152\t        CAN_IT_ERROR_PASSIVE |           // 被动错误\n153\t        CAN_IT_BUSOFF | CAN_IT_TX_MAILBOX_EMPTY);                 // 总线关闭及发送邮箱空（启动tx中断）\n154\t\n155\t    // ===== 5. 启动 CAN =====\n156\t    HAL_CAN_Start(hcan);\n157\t    CAN_Update_Bus_Status(hcan);\n158\t}\n159\t\n160\t/**\n161\t * @brief ͨ��ָ�� CAN ʵ������һ֡���ݣ������·���ͳ��״̬��\n162\t * @param hcan CAN ������ָ�룬����ָ������ʹ�õ�Ӳ��ʵ����\n163\t * @param ID ��׼֡��ʶ����\n164\t * @param Data ���������ݻ�����ָ�롣\n165\t * @param Length ���� DLC ��������ֵ��\n166\t * @return HAL_StatusTypeDef ���� HAL �㷢�ͽ����\n167\t */\n168\tHAL_StatusTypeDef CAN_Send_Data(CAN_HandleTypeDef *hcan, uint16_t ID,\n169\t                                  uint8_t *Data, uint8_t Length) {\n170\t  CAN_TxHeaderTypeDef TxHeader;\n171\t\n172\t  // TxHeader.Identifier = ID;\n173\t  // TxHeader.IdType = CAN_STANDARD_ID;\n174\t  // TxHeader.TxFrameType = CAN_DATA_FRAME;\n175\t  // TxHeader.DataLength = Length;\n176\t  // TxHeader.ErrorStateIndicator = CAN_ESI_ACTIVE;\n177\t  // TxHeader.BitRateSwitch = CAN_BRS_OFF;\n178\t  // TxHeader.FDFormat = CAN_CLASSIC_CAN;\n179\t  // TxHeader.TxEventFifoControl = CAN_NO_TX_EVENTS;\n180\t  // TxHeader.MessageMarker = 0x00;\n181\t  TxHeader.StdId = ID;\n182\t  TxHeader.ExtId = 0;\n183\t  TxHeader.IDE = CAN_ID_STD;\n184\t  TxHeader.RTR = CAN_RTR_DATA;\n185\t  TxHeader.DLC = Length;\n186\t  TxHeader.TransmitGlobalTime = DISABLE;\n187\t\n188\t\n189\t\n190\t  Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n191\t  // uint32_t tx_free_level = HAL_CAN_GetTxFifoFreeLevel(hcan);\n192\t  uint32_t tx_free_level = HAL_CAN_GetTxMailboxesFreeLevel(hcan);\n193\t  uint32_t tx_mailbox;\n194\t  HAL_StatusTypeDef send_status =\n195\t      HAL_CAN_AddTxMessage(hcan, &TxHeader, Data,&tx_mailbox);\n196\t\n197\t  CAN_Update_Tx_Status(manage_object, send_status, tx_free_level);\n198\t  if (send_status != HAL_OK) {\n199\t    CAN_Update_Bus_Status(hcan);\n200\t  }\n201\t\n202\t  return send_status;\n203\t}\n204\t\n205\t/**\n206\t * @brief ��ʵʱ��ʽ���ͱ��ģ������� FIFO ����ʱֱ�ӷ���ʧ�ܡ�\n207\t * @param hcan CAN ������ָ�룬����ָ������ʹ�õ�Ӳ��ʵ����\n208\t * @param ID ��׼֡��ʶ����\n209\t * @param Data ���������ݻ�����ָ�롣\n210\t * @param Length ���� DLC ��������ֵ��\n211\t * @return HAL_StatusTypeDef ����ʵʱ���ͽ����\n212\t */\n213\tHAL_StatusTypeDef CAN_Send_Data_Realtime(CAN_HandleTypeDef *hcan,\n214\t                                           uint16_t ID, uint8_t *Data,\n215\t                                           uint8_t Length) {\n216\t  uint32_t tx_free_level = HAL_CAN_GetTxMailboxesFreeLevel(hcan);\n217\t  if (tx_free_level == 0U) {\n218\t    CAN_Update_Tx_Status(CAN_Get_Manage_Object(hcan), HAL_ERROR,\n219\t                           tx_free_level);\n220\t    CAN_Update_Bus_Status(hcan);\n221\t    return HAL_ERROR;\n222\t  }\n223\t\n224\t  return CAN_Send_Data(hcan, ID, Data, Length);\n225\t}\n226\t\n227\t/**\n228\t * @brief ˢ��ָ�� CAN ʵ����Э��״̬������״̬�� FIFO ������ȡ�\n229\t * @param hcan CAN ������ָ�룬����ָ��������״̬��Ӳ��ʵ����\n230\t */\n231\tvoid CAN_Update_Bus_Status(CAN_HandleTypeDef *hcan) {\n232\t  Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n233\t  if (manage_object == nullptr) {\n234\t    return;\n235\t  }\n236\t\n237\t  // BXCAN 通过直接读取 CAN 控制器寄存器获取协议状态\n238\t  manage_object->Status.Last_Protocol_Status = 0U;\n239\t  \n240\t  // 读取 CAN 控制器状态寄存器\n241\t  uint32_t msr = hcan->Instance->MSR;  // 模式状态寄存器\n242\t  uint32_t esr = hcan->Instance->ESR;  // 错误状态寄存器\n243\t  \n244\t  // bit[0:2]: 最后错误代码 (LEC)\n245\t  manage_object->Status.Last_Protocol_Status |= (esr & 0x7U);\n246\t  \n247\t  // bit[3:5]: 数据段最后错误代码 (BXCAN不支持，设为0)\n248\t  manage_object->Status.Last_Protocol_Status |= (0U << 3);\n249\t  \n250\t  // bit[6:7]: 总线活动状态\n251\t  manage_object->Status.Last_Protocol_Status |= ((((msr >> 1) & 0x1U)) << 6);\n252\t  manage_object->Status.Last_Protocol_Status |= ((((msr >> 0) & 0x1U)) << 7);\n253\t  \n254\t  // bit[8]: 错误被动状态 (EP)\n255\t  manage_object->Status.Last_Protocol_Status |= ((((esr >> 4) & 0x1U)) << 8);\n256\t  \n257\t  // bit[9]: 警告状态 (EWGF)\n258\t  manage_object->Status.Last_Protocol_Status |= ((((esr >> 2) & 0x1U)) << 9);\n259\t  \n260\t  // bit[10]: 总线关闭状态 (BS)\n261\t  manage_object->Status.Last_Protocol_Status |= ((((msr >> 2) & 0x1U)) << 10);\n262\t\n263\t  manage_object->Status.Last_Error_Status = HAL_CAN_GetError(hcan);\n264\t  manage_object->Status.Last_Tx_Free_Level =\n265\t      HAL_CAN_GetTxMailboxesFreeLevel(hcan);\n266\t}\n267\t\n268\t/**\n269\t * @brief 获取指定 CAN 外设对应的状态统计结构体指针。\n270\t * @param hcan CAN 外设句柄指针，用于匹配对应的管理对象。\n271\t * @return Struct_CAN_Status* 返回状态结构体指针，未匹配到时返回空指针。\n272\t */\n273\tStruct_CAN_Status *CAN_Get_Status(CAN_HandleTypeDef *hcan) {\n274\t    Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n275\t    if (manage_object == nullptr) {\n276\t        return nullptr;\n277\t    }\n278\t    return &manage_object->Status;\n279\t}\n280\t\n281\t/**\n282\t * @brief CAN ������� 1ms ��������ص��������·������Կ��Ʊ��ġ�\n283\t */\n284\tvoid RTOS_1ms_CAN_Motor_Callback() {\n285\t  // DJI ������Ʊ���\n286\t\n287\t  // ���̵�����Ʊ��ģ�ID ��Ӧ 0x201~0x204��\n288\t  // CAN_Send_Data_Realtime(&hcan1, 0x200, CAN1_0x200_Tx_Data,\n289\t  //                          8U);\n290\t  // ��̨����չ������Ʊ��ģ�ID ��Ӧ 0x205~0x20B��\n291\t  //CAN_Send_Data_Realtime(&hcan1, 0x1ff, CAN1_0x1ff_Tx_Data,\n292\t  //                           CAN_DLC_BYTES_8);\n293\t}\n294\t\n295\t/**\n296\t * @brief CAN FIFO0 �����жϻص������ڶ�ȡ FIFO0 �е��±��Ĳ������ϲ�ص���\n297\t * @param hcan CAN ������ָ�룬���ڱ�ʶ�����жϵ�Ӳ��ʵ����\n298\t * @param RxFifo0ITs FIFO0 �ж�״̬��־��\n299\t */\n300\tvoid HAL_CAN_RxFifo0Callback(CAN_HandleTypeDef *hcan,\n301\t                               uint32_t RxFifo0ITs) {\n302\t\n303\t  if ((RxFifo0ITs & CAN_IT_RX_FIFO0_MSG_PENDING) == RESET)\n304\t    return;\n305\t\n306\t  Struct_CAN_Manage_Object *manager_obj;\n307\t\n308\t  if(hcan->Instance == CAN1)\n309\t   manager_obj = &CAN1_Manage_Object;\n310\t  else if(hcan->Instance == CAN2)\n311\t   manager_obj = &CAN2_Manage_Object;\n312\t  else\n313\t   return;\n314\t\n315\t  HAL_CAN_GetRxMessage(hcan,CAN_RX_FIFO0, &manager_obj->Rx_Buffer.Header, manager_obj->Rx_Buffer.Data);\n316\t\n317\t  if (!init_finished)\n318\t    return;\n319\t  //�ϲ�ص�����\n320\t  if(manager_obj->Callback_Function != nullptr)\n321\t  {\n322\t    manager_obj->Callback_Function(&manager_obj->Rx_Buffer);\n323\t  }\n324\t}\n325\t\n326\t/**\n327\t * @brief CAN FIFO1 �����жϻص������ڶ�ȡ FIFO1 �е��±��Ĳ������ϲ�ص���\n328\t * @param hcan CAN ������ָ�룬���ڱ�ʶ�����жϵ�Ӳ��ʵ����\n329\t * @param RxFifo1ITs FIFO1 �ж�״̬��־��\n330\t */\n331\tvoid HAL_CAN_RxFifo1Callback(CAN_HandleTypeDef *hcan,\n332\t                               uint32_t RxFifo1ITs) {\n333\t\n334\t  if ((RxFifo1ITs & CAN_IT_RX_FIFO1_MSG_PENDING) == RESET)\n335\t    return;\n336\t\n337\t  Struct_CAN_Manage_Object* manager_obj;\n338\t\n339\t  if(hcan->Instance == CAN1)\n340\t   manager_obj = &CAN1_Manage_Object;\n341\t  else if(hcan->Instance == CAN2)\n342\t   manager_obj = &CAN2_Manage_Object;\n343\t  else\n344\t   return;\n345\t\n346\t  HAL_CAN_GetRxMessage(hcan,CAN_RX_FIFO1, &manager_obj->Rx_Buffer.Header, manager_obj->Rx_Buffer.Data);\n347\t  if (!init_finished)\n348\t    return;\n349\t\n350\t  //�ϲ�ص�����\n351\t  if(manager_obj->Callback_Function != nullptr)\n352\t  {\n353\t    manager_obj->Callback_Function(&manager_obj->Rx_Buffer);\n354\t  }\n355\t}\n356\t\n357\t\n358\t/**\n359\t * @brief CAN ����״̬�жϻص������ڼ�¼ Warning��Error Passive �� Bus-Off �¼���ˢ������״̬��\n360\t * @param hcan CAN ������ָ�룬���ڱ�ʶ��������״̬�жϵ�Ӳ��ʵ����\n361\t * @param ErrorStatusITs ����״̬�жϱ�־λ���������� Warning��Error Passive �� Bus-Off �¼���\n362\t */\n363\tvoid HAL_CAN_ErrorStatusCallback(CAN_HandleTypeDef *hcan,\n364\t                                   uint32_t ErrorStatusITs) {\n365\t  Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n366\t  if (manage_object != nullptr) {\n367\t    manage_object->Status.Last_Error_Status = ErrorStatusITs;\n368\t  }\n369\t\n370\t  // Warning �� Error Passive ֻ��״̬���������ڸý׶�ֱ���������ߡ�\n371\t  if ((ErrorStatusITs & (CAN_IT_ERROR_WARNING | CAN_IT_ERROR_PASSIVE)) !=\n372\t      0U) {\n373\t    CAN_Update_Bus_Status(hcan);\n374\t  }\n375\t\n376\t  if ((ErrorStatusITs & CAN_IT_BUSOFF) != 0U) {\n377\t    if (manage_object != nullptr) {\n378\t      manage_object->Status.Bus_Off_Count++;\n379\t    }\n380\t\n381\t    HAL_CAN_Stop(hcan);\n382\t\n383\t    if (HAL_CAN_Start(hcan) == HAL_OK) {\n384\t\n385\t      HAL_CAN_ActivateNotification(hcan,\n386\t                                     CAN_IT_RX_FIFO0_MSG_PENDING |\n387\t                                         CAN_IT_RX_FIFO1_MSG_PENDING |\n388\t                                         CAN_IT_ERROR_WARNING |\n389\t                                         CAN_IT_ERROR_PASSIVE |\n390\t                                         CAN_IT_BUSOFF);\n391\t    }\n392\t  }\n393\t\n394\t  CAN_Update_Bus_Status(hcan);\n395\t}\n396\t\n397\t\n398\t\n399\t\n400\t\n401"
                }
