                    "text": "1\t//\n2\t// Created by 24158 on 2026/6/15.\n3\t//\n4\t\n5\t#include \"robotdog_class.h\"\n6\t\n7\t#include \"callback_task.h\"\n8\t\n9\tvolatile bool robot_1ms_cycle_flag = false;\n10\tvolatile bool robot_100ms_cycle_flag = false;\n11\tvolatile bool robot_1000ms_cycle_flag = false;\n12\t\n13\tfloat theta = 0;\n14\tfloat theta1 = 0;\n15\tfloat theta2 = 0;\n16\tfloat Xe1;\n17\tfloat Ye1;\n18\t\n19\tfloat Xe2;\n20\tfloat Ye2;\n21\t\n22\tfloat Xe3;\n23\tfloat Ye3;\n24\t\n25\tfloat Xe4;\n26\tfloat Ye4;\n27\t\n28\tfloat X = 0;\n29\tfloat Y = -0.10;\n30\t\n31\tfloat R = 0.0;\n32\tfloat theta_polar = 0.0;\n33\t\n34\tuint8_t flag_trun = 0;\n35\tfloat fine_FB = 0;\n36\tfloat fine_RL = 0;\n37\tfloat fine_R_hight = 0;\n38\tfloat fine_L_hight = 0;\n39\t\n40\tfloat fine_R_L_direction = 0.0f;\n41\t// float kp = 4.5f,kd = 0.1f,angle = 0.0f,Omega = 0.0f,Torque = 0.00f;//测试用\n42\t\n43\tint8_t jump_set_flag = 0;\n44\t\n45\tvoid Class_DOG::Chassis_Init()\n46\t{\n47\t\n48\t\n49\t\n50\t\n51\t//默认使用MIT模式\n52\t    Foot1_Left_Back.SingleFoot_Init(&hcan1,0x11,0x01,&hcan1,0x12,0x02,Left,kp,kd,angle,Omega,-Torque);\n53\t    Foot2_Right_Back.SingleFoot_Init(&hcan1,0x14,0x04,&hcan1,0x13,0x03,Right,kp,kd,angle,Omega,Torque);\n54\t    Foot3_Left_Front.SingleFoot_Init(&hcan2,0x18,0x08,&hcan2,0x17,0x07,Left,kp,kd,angle,Omega,-Torque);\n55\t    Foot4_Right_Front.SingleFoot_Init(&hcan2,0x15,0x05,&hcan2,0x16,0x06,Right,kp,kd,angle,Omega,Torque);\n56\t\n57\t    Jump_fsm.Init(4,0);\n58\t\n59\t}\n60\t\n61\t\n62\t\n63\tvoid Class_DOG::FSi6x_control()//直角坐标系\n64\t{\n65\t\n66\t    if (fsia6b_msg.ch[5] >= 1751 && flag_jump == 0 && fsia6b_msg.ch[4]==1000)\n67\t    {\n68\t        X = Math_Int_To_Float(fsia6b_msg.ch[3],1000,2000,-0.06f,+0.06f);\n69\t        Y = Math_Int_To_Float(fsia6b_msg.ch[2],1000,2000,-0.060f,-0.19f);\n70\t        fine_FB = Math_Int_To_Float(fsia6b_msg.ch[9],1000,2000,+0.02f,-0.02f);\n71\t        fine_L_hight = 0.0;\n72\t        fine_R_hight = 0.0;//操作逻辑干涉了\n73\t    }else if (fsia6b_msg.ch[5] < 1500 && flag_jump == 0&& fsia6b_msg.ch[4]==1000)\n74\t    {\n75\t        X = Math_Int_To_Float(fsia6b_msg.ch[8],1000,2000,-0.06f,+0.06f);\n76\t        Y = Math_Int_To_Float(fsia6b_msg.ch[2],1000,2000,-0.060f,-0.19f);\n77\t        fine_FB = Math_Int_To_Float(fsia6b_msg.ch[9],1000,2000,+0.02f,-0.02f);\n78\t        fine_L_hight = 0.0;\n79\t        fine_R_hight = 0.0;\n80\t    }else if (fsia6b_msg.ch[5] >= 1751 && flag_jump == 0 && fsia6b_msg.ch[4]==2000)\n81\t    {\n82\t        fine_R_hight = Math_Int_To_Float(fsia6b_msg.ch[9],1000,2000,+0.00f,-0.12f);\n83\t        fine_L_hight = Math_Int_To_Float(fsia6b_msg.ch[8],1000,2000,+0.00f,-0.12f);\n84\t        X = Math_Int_To_Float(fsia6b_msg.ch[3],1000,2000,-0.06f,+0.06f);\n85\t        Y = Math_Int_To_Float(fsia6b_msg.ch[2],1000,2000,-0.060f,-0.19f);\n86\t\n87\t    }\n88\t\n89\t\n90\t\n91\t    //用于更新数据而不带控制数值更改\n92\t    if ( fsia6b_msg.ch[5] > 1751 && flag_jump == 0)\n93\t    {\n94\t        if ( fsia6b_msg.ch[1] > 1550  && theta <= 2*Pi && theta >= 0 && fsia6b_msg.ch[0] < 1550 && fsia6b_msg.ch[0] > 1450)\n95\t        {\n96\t            theta += 0.0 + Math_Int_To_Float(fsia6b_msg.ch[1],1000,2000,-0.25,+0.25);\n97\t\n98\t            // Xe1 = X + (0.04 + test1) * cos(theta);\n99\t            // Ye1 = Y + (0.03 + test1) * sin(theta);\n100\t            //\n101\t            // Xe4 = X + (0.04 + test1) * cos(theta - 3*Pi/2 );\n102\t            // Ye4 = Y + (0.03 + test1) * sin(theta - 3*Pi/2);\n103\t            //\n104\t            // Xe2 = X + (0.04 + test1)  * cos(theta - Pi/2);\n105\t            // Ye2 = Y + (0.03 + test1) * sin(theta - Pi/2);\n106\t            //\n107\t            // Xe3 = X + (0.04 + test1)  * cos(theta - Pi);\n108\t            // Ye3 = Y + (0.03 + test1) * sin(theta - Pi);\n109\t            //特定步幅及速度情况下可以实现右转\n110\t\n111\t            Xe1 = X + (0.04 + fine_FB) * cos(theta);\n112\t            Ye1 = Y + (0.03 + fine_FB) * sin(theta);\n113\t\n114\t            Xe4 = X + (0.04 + fine_FB) * cos(theta);\n115\t            Ye4 = Y + (0.03 + fine_FB) * sin(theta);\n116\t\n117\t            Xe2 = X + (0.04 + fine_FB)  * cos(theta - Pi);\n118\t            Ye2 = Y + (0.03 + fine_FB) * sin(theta - Pi);\n119\t\n120\t            Xe3 = X + (0.04 + fine_FB)  * cos(theta - Pi);\n121\t            Ye3 = Y + (0.03 + fine_FB) * sin(theta - Pi);\n122\t\n123\t        }\n124\t        else if (fsia6b_msg.ch[1] < 1450 && theta >= -2*Pi && theta <= 0&& fsia6b_msg.ch[0] < 1550 && fsia6b_msg.ch[0] > 1450)\n125\t        {\n126\t            theta += 0.0 + Math_Int_To_Float(fsia6b_msg.ch[1],1000,2000,-0.20,+0.20);\n127\t\n128\t            Xe1 = X + (0.04 + fine_FB) * cos(theta);\n129\t            Ye1 = Y + (0.03 + fine_FB) * sin(theta);\n130\t\n131\t            Xe4 = X + (0.04 + fine_FB) * cos(theta);\n132\t            Ye4 = Y + (0.03 + fine_FB) * sin(theta);\n133\t\n134\t            Xe2 = X + (0.04 + fine_FB)  * cos(theta - Pi);\n135\t            Ye2 = Y + (0.03 + fine_FB) * sin(theta - Pi);\n136\t\n137\t            Xe3 = X + (0.04 + fine_FB)  * cos(theta - Pi);\n138\t            Ye3 = Y + (0.03 + fine_FB) * sin(theta - Pi);\n139\t        }\n140\t        else if ( fsia6b_msg.ch[0] > 1750  && theta <= 2*Pi && theta >= 0 && fsia6b_msg.ch[1] < 1550 && fsia6b_msg.ch[1] > 1450)\n141\t        {\n142\t            theta += 0.0 + Math_Int_To_Float(fsia6b_msg.ch[0],1000,2000,-0.20,+0.20);\n143\t\n144\t            Xe1 = X + (0.04 + fine_RL) * cos(theta);\n145\t            Ye1 = Y + (0.02 + fine_RL) * sin(theta);\n146\t            Xe4 = X + (0.04 + fine_RL) * cos(theta);\n147\t            Ye4 = Y + (0.02 + fine_RL) * sin(theta);\n148\t\n149\t            Xe3 = X + (0.01 + fine_RL) * cos(theta - Pi);\n150\t            Ye3 = Y + (0.02 * fine_RL) * sin(theta - Pi);\n151\t            Xe2 = X + (0.01 + fine_RL) * cos(theta - Pi);\n152\t            Ye2 = Y + (0.02 * fine_RL) * sin(theta - Pi);\n153\t\n154\t        }\n155\t        else if (fsia6b_msg.ch[0] < 1250 && theta >= -2*Pi && theta <= 0 && fsia6b_msg.ch[1] < 1550 && fsia6b_msg.ch[1] > 1450)\n156\t        {\n157\t            theta += 0.0 + Math_Int_To_Float(fsia6b_msg.ch[0],1000,2000,-0.20,+0.20);\n158\t\n159\t            Xe1 = X - (0.01 + fine_RL) * cos(theta);\n160\t            Ye1 = Y + (0.02 + fine_RL) * sin(theta);\n161\t            Xe4 = X - (0.01 + fine_RL) * cos(theta);\n162\t            Ye4 = Y + (0.02 + fine_RL) * sin(theta);\n163\t\n164\t            Xe3 = X - (0.04 + fine_RL) * cos(theta - Pi);\n165\t            Ye3 = Y + (0.02 + fine_RL) * sin(theta - Pi);\n166\t            Xe2 = X - (0.04 + fine_RL) * cos(theta - Pi);\n167\t            Ye2 = Y + (0.02 + fine_RL) * sin(theta - Pi);\n168\t        }\n169\t        else if (fsia6b_msg.ch[1] < 1550 && fsia6b_msg.ch[1] > 1450 && fsia6b_msg.ch[0] < 1550 && fsia6b_msg.ch[0] > 1450 )\n170\t        {\n171\t            Xe1 = X;\n172\t            Ye1 = Y;\n173\t            Xe2 = X;\n174\t            Ye2 = Y;\n175\t            Xe3 = X;\n176\t            Ye3 = Y;\n177\t            Xe4 = X;\n178\t            Ye4 = Y;\n179\t            //未推杆时的回位\n180\t        }else\n181\t        {\n182\t            theta = 0;//防止长时间累加导致的溢出，用周期性限制\n183\t        }\n184\t\n185\t        // Foot1_Left_Back.Set_x_y(Xe1,Ye1);\n186\t        // Foot2_Right_Back.Set_x_y(Xe3,Ye3);\n187\t        // Foot3_Left_Front.Set_x_y(Xe3,Ye3);\n188\t        // Foot4_Right_Front.Set_x_y(Xe1,Ye1);\n189\t\n190\t        Foot1_Left_Back.Set_x_y(Xe1,Ye1+fine_L_hight);\n191\t        Foot2_Right_Back.Set_x_y(Xe2,Ye2+fine_R_hight);\n192\t        Foot3_Left_Front.Set_x_y(Xe3,Ye3+fine_L_hight);\n193\t        Foot4_Right_Front.Set_x_y(Xe4,Ye4+fine_R_hight);\n194\t    }else if (fsia6b_msg.ch[5] < 1500 && flag_jump == 0)\n195\t    {\n196\t        // if (theta > 0)\n197\t        // {\n198\t        //     theta -= 0.01;\n199\t        // }else if (theta < 0)\n200\t        // {\n201\t        //     theta += 0.01;\n202\t        //\n203\t        //\n204\t        // }\n205\t        //\n206\t        // Xe1 = X + 0.04 * cos(theta);\n207\t        // Ye1 = Y + 0.03 * sin(theta);\n208\t        //\n209\t        // Xe3 = X + 0.04 * cos(theta - Pi);\n210\t        // Ye3 = Y + 0.03 * sin(theta - Pi);\n211\t        Xe1 = X;\n212\t        Ye1 = Y;\n213\t        Xe2 = X;\n214\t        Ye2 = Y;\n215\t        Xe3 = X;\n216\t        Ye3 = Y;\n217\t        Xe4 = X;\n218\t        Ye4 = Y;\n219\t        //未推杆时的回位\n220\t        // Foot1_Left_Back.Set_x_y(Xe1,Ye1);\n221\t        // Foot2_Right_Back.Set_x_y(Xe2,Ye2);\n222\t        // Foot3_Left_Front.Set_x_y(Xe3,Ye3);\n223\t        // Foot4_Right_Front.Set_x_y(Xe4,Ye4);\n224\t\n225\t    }\n226\t\n227\t\n228\t        if (fsia6b_msg.ch[6] == 2000)\n229\t        {\n230\t            Xe1 = X;\n231\t            Ye1 = -0.17;\n232\t            Xe2 = X;\n233\t            Ye2 = -0.17;\n234\t            Xe3 = X;\n235\t            Ye3 = -0.17;\n236\t            Xe4 = X;\n237\t            Ye4 = -0.17;\n238\t            float Torque1 = 0.00f;\n239\t            if (fsia6b_msg.ch[7] == 1000)\n240\t            {\n241\t                Foot1_Left_Back.SingleFoot_Init(&hcan1,0x11,0x01,&hcan1,0x12,0x02,Left,20,0.1,angle,Omega,-Torque1);\n242\t                Foot2_Right_Back.SingleFoot_Init(&hcan1,0x14,0x04,&hcan1,0x13,0x03,Right,20,0.1,angle,Omega,Torque1);\n243\t                Foot3_Left_Front.SingleFoot_Init(&hcan2,0x18,0x08,&hcan2,0x17,0x07,Left,20,0.1,angle,Omega,-Torque1);\n244\t                Foot4_Right_Front.SingleFoot_Init(&hcan2,0x15,0x05,&hcan2,0x16,0x06,Right,20,0.1,angle,Omega,Torque1);\n245\t            }else if (fsia6b_msg.ch[7] == 2000)\n246\t            {\n247\t                Foot1_Left_Back.SingleFoot_Init(&hcan1,0x11,0x01,&hcan1,0x12,0x02,Left,90,0.1,angle,Omega,-Torque1);\n248\t                Foot2_Right_Back.SingleFoot_Init(&hcan1,0x14,0x04,&hcan1,0x13,0x03,Right,90,0.1,angle,Omega,Torque1);\n249\t                Foot3_Left_Front.SingleFoot_Init(&hcan2,0x18,0x08,&hcan2,0x17,0x07,Left,90,0.1,angle,Omega,-Torque1);\n250\t                Foot4_Right_Front.SingleFoot_Init(&hcan2,0x15,0x05,&hcan2,0x16,0x06,Right,90,0.1,angle,Omega,Torque1);\n251\t            }\n252\t\n253\t                flag_jump = 1;\n254\t\n255\t        }else if (fsia6b_msg.ch[6] == 1500)\n256\t        {\n257\t            Xe1 = X;\n258\t            Ye1 = -0.09;\n259\t            Xe2 = X;\n260\t            Ye2 = -0.09;\n261\t            Xe3 = X;\n262\t            Ye3 = -0.09;\n263\t            Xe4 = X;\n264\t            Ye4 = -0.09;\n265\t            // float a = Foot1_Left_Back.mi.Get_Now_Angle();\n266\t            // float Torque1 = 0.35f;\n267\t            if (fsia6b_msg.ch[7] == 1000)\n268\t            {\n269\t                Foot1_Left_Back.SingleFoot_Init(&hcan1,0x11,0x01,&hcan1,0x12,0x02,Left,2.0,kd,angle,Omega,-Torque);\n270\t                Foot2_Right_Back.SingleFoot_Init(&hcan1,0x14,0x04,&hcan1,0x13,0x03,Right,2.0,kd,angle,Omega,Torque);\n271\t                Foot3_Left_Front.SingleFoot_Init(&hcan2,0x18,0x08,&hcan2,0x17,0x07,Left,2.0,kd,angle,Omega,-Torque);\n272\t                Foot4_Right_Front.SingleFoot_Init(&hcan2,0x15,0x05,&hcan2,0x16,0x06,Right,2.0,kd,angle,Omega,Torque);\n273\t            }else if (fsia6b_msg.ch[7] == 2000)\n274\t            {\n275\t                Foot1_Left_Back.SingleFoot_Init(&hcan1,0x11,0x01,&hcan1,0x12,0x02,Left,1.5,kd,angle,Omega,-Torque);\n276\t                Foot2_Right_Back.SingleFoot_Init(&hcan1,0x14,0x04,&hcan1,0x13,0x03,Right,1.5,kd,angle,Omega,Torque);\n277\t                Foot3_Left_Front.SingleFoot_Init(&hcan2,0x18,0x08,&hcan2,0x17,0x07,Left,1.5,kd,angle,Omega,-Torque);\n278\t                Foot4_Right_Front.SingleFoot_Init(&hcan2,0x15,0x05,&hcan2,0x16,0x06,Right,1.5,kd,angle,Omega,Torque);\n279\t\n280\t            }\n281\t                flag_jump = 2;\n282\t\n283\t        }else if (fsia6b_msg.ch[6] == 1000 && flag_jump !=0)\n284\t        {\n285\t            Foot1_Left_Back.SingleFoot_Init(&hcan1,0x11,0x01,&hcan1,0x12,0x02,Left,kp,kd,angle,Omega,-Torque);\n286\t            F