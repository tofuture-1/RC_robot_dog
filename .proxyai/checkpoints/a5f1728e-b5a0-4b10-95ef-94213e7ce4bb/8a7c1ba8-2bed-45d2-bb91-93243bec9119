loat(fsia6b_msg.ch[3],1000,2000,3.925f,5.495f);\n324\t        R = Math_Int_To_Float(fsia6b_msg.ch[2],1000,2000,0.060f,0.19f);\n325\t        //fine_FB = Math_Int_To_Float(fsia6b_msg.ch[9],1000,2000,+0.02f,-0.02f);\n326\t        fine_RL = Math_Int_To_Float(fsia6b_msg.ch[9],1000,2000,+0.02f,-0.02f);\n327\t\n328\t        fine_L_hight = 0.0;\n329\t        fine_R_hight = 0.0;\n330\t    }else if (fsia6b_msg.ch[5] >= 1751 && flag_jump != 1 && fsia6b_msg.ch[4]==2000)\n331\t    {\n332\t        theta_polar = Math_Int_To_Float(fsia6b_msg.ch[3],1000,2000,3.925f,5.495f);\n333\t        R = Math_Int_To_Float(fsia6b_msg.ch[2],1000,2000,0.060f,0.19f);\n334\t\n335\t\n336\t        fine_FB = Math_Int_To_Float(fsia6b_msg.ch[9],1000,2000,+0.02f,-0.02f);\n337\t        fine_L_hight = Math_Int_To_Float(fsia6b_msg.ch[8],1000,2000,+0.00f,-0.12f);\n338\t\n339\t    }\n340\t\n341\t\n342\t\n343\t    //极坐标转换成直角坐标\n344\t    X = cos(theta_polar) * R;\n345\t    Y = sin(theta_polar) * R;\n346\t\n347\t    //用于更新数据而不带控制数值更改\n348\t    if ( fsia6b_msg.ch[5] > 1751 && flag_jump == 0)\n349\t    {\n350\t        if ( fsia6b_msg.ch[1] > 1550  && theta <= 2*Pi && theta >= 0 && fsia6b_msg.ch[0] > 1001 && fsia6b_msg.ch[0] < 1999)\n351\t        {\n352\t            theta += 0.0 + Math_Int_To_Float(fsia6b_msg.ch[1],1000,2000,-0.030,+0.030);\n353\t\n354\t            //fine_FB = Math_Int_To_Float(fsia6b_msg.ch[1],1500,2000,0.0f,+0.03f);\n355\t\n356\t            fine_R_L_direction = Math_Int_To_Float(fsia6b_msg.ch[0],1000,2000,-0.045,+0.045);\n357\t\n358\t            Xe1 = X + (0.04 + fine_FB + fine_R_L_direction) * cos(theta);\n359\t            Ye1 = Y + (0.02 + fine_FB*0.4) * sin(theta);\n360\t\n361\t            Xe4 = X + (0.04 + fine_FB + fine_R_L_direction) * cos(theta);\n362\t            Ye4 = Y + (0.02 + fine_FB*0.4) * sin(theta);\n363\t\n364\t            Xe2 = X + (0.04 + fine_FB - fine_R_L_direction)  * cos(theta - Pi);\n365\t            Ye2 = Y + (0.02 + fine_FB*0.4) * sin(theta - Pi);\n366\t\n367\t            