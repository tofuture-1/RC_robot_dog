                    "text": "1\t//\n2\t// Created by 24158 on 2026/6/15.\n3\t//\n4\t\n5\t#include \"foot_control.h\"\n6\t#include \"Motor_DM.h\"\n7\t\n8\tvoid Class_SingleDogFoot_DM::SingleFoot_Init(CAN_HandleTypeDef *Mo_hcan, uint16_t Mo_CAN_Rx_ID,uint16_t  Mo_CAN_Tx_ID,\n9\t\tCAN_HandleTypeDef *Mi_hcan,uint16_t Mi_CAN_Rx_ID, uint16_t Mi_CAN_Tx_ID,uint8_t L_R_sidex,\n10\t\tfloat kp, float kd, float Angle,float Omega,float Torque)\n11\t{\n12\t\tL_R_side = L_R_sidex;\n13\t\n14\t\tmo_hcan = Mo_hcan;\n15\t\tmo_CAN_Rx_ID = Mo_CAN_Rx_ID;\n16\t\tmo_CAN_Tx_ID = Mo_CAN_Tx_ID;\n17\t\n18\t\tmi_hcan = Mi_hcan;\n19\t\tmi_CAN_Rx_ID = Mi_CAN_Rx_ID;\n20\t\tmi_CAN_Tx_ID = Mi_CAN_Tx_ID;\n21\t\n22\t\tmo.Init(mo_hcan, mo_CAN_Rx_ID, mo_CAN_Tx_ID);\n23\t\tmi.Init(mi_hcan, mi_CAN_Rx_ID, mi_CAN_Tx_ID);\n24\t\n25\t\n26\t\n27\t\tmo.Set_K_P(kp);\n28\t\tmo.Set_K_D(kd);\n29\t\tmo.Set_Control_Angle(Angle);\n30\t\tmo.Set_Control_Omega(Omega);\n31\t\tmo.Set_Control_Torque(Torque);\n32\t\n33\t\tmi.Set_K_P(kp);\n34\t\tmi.Set_K_D(kd);\n35\t\tmi.Set_Control_Angle(Angle);\n36\t\tmi.Set_Control_Omega(Omega);\n37\t\tmi.Set_Control_Torque(Torque);\n38\t\n39\t\t// mo.CAN_Send_Enter();\n40\t\t// mi.CAN_Send_Enter();//为什么在这里调用会导致整个回传及发送的帧停滞发送？//因为发送之后一直会进接收中断，导致与之后的HAL_delay(100)反复中断卡死，进而导致init_finished一直不能被置true\n41\t//但是为什么会导致总线上一样收不到电机的回传数据？？？\n42\t\n43\t\n44\t}\n45\t\n46\tint8_t  Class_SingleDogFoot_DM::FootXY_map_MotorAngle()\n47\t{\n48\t\n49\t\td_AD = sqrt(X*X + Y*Y);\n50\t\n51\t\t\tif (d_AD > Long_L + Short_L || d_AD < fabs(Long_L - Short_L))\n52\t\t{\n53\t    return 0;\n54\t\t}\n55\t\n56\t\t//提前，防止除0错误\n57\t\n58\t\tdouble a = (Short_L*Short_L + d_AD*d_AD - Long_L*Long_L)/(2.0*Short_L*d_AD);\n59\t\n60\t\t//适用于atan2恒为负值时\n61\t\tmotor_angle_raw_inside = acos(a) + atan2(Y,X);\n62\t\tmotor_angle_raw_outside = -acos(a) + atan2(Y,X);\n63\t\t//计算角度原数据,均以水平x轴正向为基准,后面要考虑越轴-只有外侧电机要考虑？\n64\t\n65\t\n66\t\n67\t\tmotor_angle_DM_inside =  motor_angle_raw_inside;\n68\t\tmotor_angle_DM_outside = (-Pi - motor_angle_raw_outside);\n69\t\n70\t\n71\t\t//限位，不应该直接大跳，保持上一次可行的发送\n72\t\tif(fabs(motor_angle_DM_inside) > High_limit || -fabs(motor_angle_DM_inside) < Low_limit || fabs(motor_angle_DM_outside) > High_limit || -fabs(motor_angle_DM_outside) < Low_limit)\n73\t\t{\n74\t\t\tmotor_angle_DM_inside = pre_motor_angle_DM_inside;\n75\t\t\tmotor_angle_DM_outside = pre_motor_angle_DM_outside;\n76\t\t\tif(L_R_side == Left)\n77\t\t\t{\n78\t\t\t\tmi.Set_Control_Angle(motor_angle_DM_inside);\n79\t\t\t\tmo.Set_Control_Angle(motor_angle_DM_outside);\n80\t\n81\t\t\t}else if(L_R_side == Right)\n82\t\t\t{\n83\t\t\t\tmi.Set_Control_Angle(-motor_angle_DM_inside);\n84\t\t\t\tmo.Set_Control_Angle(-motor_angle_DM_outside);\n85\t\n86\t\t\t}else\n87\t\t\t{\n88\t\t\t\treturn 2;\n89\t\t\t}\n90\t\t\treturn 0;\n91\t\t}else{\n92\t\t\tif(L_R_side == Left)\n93\t\t\t{\n94\t\t\t\tmi.Set_Control_Angle(motor_angle_DM_inside);\n95\t\t\t\tmo.Set_Control_Angle(motor_angle_DM_outside);\n96\t\t\t\tpre_motor_angle_DM_inside = motor_angle_DM_inside;\n97\t\t\t\tpre_motor_angle_DM_outside = motor_angle_DM_outside;\n98\t\t\t}else if(L_R_side == Right)\n99\t\t\t{\n100\t\t\t\tmi.Set_Control_Angle(-motor_angle_DM_inside);\n101\t\t\t\tmo.Set_Control_Angle(-motor_angle_DM_outside);\n102\t\t\t\tpre_motor_angle_DM_inside = motor_angle_DM_inside;\n103\t\t\t\tpre_motor_angle_DM_outside = motor_angle_DM_outside;\n104\t\t\t}else\n105\t\t\t{\n106\t\t\t\treturn 0;\n107\t\t\t}\n108\t\t\treturn 1;\n109\t\t}\n110\t\n111\t\n112\t\n113\t\n114\t}\n115\t\n116\tHAL_StatusTypeDef Class_SingleDogFoot_DM::Foot_control()\n117\t{\n118\t\t// float kp, float kd, float Angle,float Omega,float Torque\n119\t\t// mo.Set_K_P(kp);\n120\t\t// mo.Set_K_D(kd);\n121\t\t// mo.Set_Control_Angle(Angle);\n122\t\t// mo.Set_Control_Omega(Omega);\n123\t\t// mo.Set_Control_Torque(Torque);\n124\t\t//\n125\t\t// mi.Set_K_P(kp);\n126\t\t// mi.Set_K_D(kd);\n127\t\t// mi.Set_Control_Angle(Angle);\n128\t\t// mi.Set_Control_Omega(Omega);\n129\t\t// mi.Set_Control_Torque(Torque);\n130\t\n131\t\tFootXY_map_MotorAngle();\n132\t\n133\t\tmi.Dog_Send_Callback();\n134\t\tmo.Dog_Send_Callback();\n135\t\treturn HAL_OK;\n136\t}\n137\t\n138\t/*\n139\tHAL_StatusTypeDef Bluetooth_control(UART_HandleTypeDef *huartx)\n140\t{\n141\t\n142\tif (uart1_cmd_ready)\n143\t{\n144\t    uart1_cmd_ready = 0;\n145\t\n146\t    // 将接收到的int值转换为short（如果需要）\n147\t    speed = (int16_t)uart1_rx_value;\n148\t    Motor_SetTargetSpeed(&motor1, speed);\n149\t\n150\t    // 构造发送数据包（11字节）：帧头 + 原数据(4+4字节) + 校验和 + 帧尾\n151\t    uint8_t tx_buffer[11];\n152\t    tx_buffer[0] = 0xA5;                          // 帧头\n153\t    // 原数据（小端模式，与接收解析一致）\n154\t    tx_buffer[1] = (uint8_t)(uart1_rx_value & 0xFF);？？？\n155\t    tx_buffer[2] = (uint8_t)((uart1_rx_value >> 8) & 0xFF);\n156\t    tx_buffer[3] = (uint8_t)((uart1_rx_value >> 16) & 0xFF);\n157\t    tx_buffer[4] = (uint8_t)((uart1_rx_value >> 24) & 0xFF);\n158\t    // 校验和：原数据4字节之和的低8位\n159\t    tx_buffer[5] = tx_buffer[1] + tx_buffer[2] + tx_buffer[3] + tx_buffer[4];\n160\t    tx_buffer[6] = 0x5A;                          // 帧尾\n161\t\n162\t    HAL_UART_Transmit(huartx, tx_buffer, 7, 100);\n163\t}\n164\t}\n165\t*/\n166\t\n167\t// void DM_Motor_FootData_SendVOFA_Firewater(Foot *footx,UART_HandleTypeDef *huart)\n168\t// {\n169\t// \t\tuint32_t current_time = HAL_GetTick();\n170\t// \t\t//设置UART发送缓冲\n171\t// \t\tchar buffer[100];\n172\t// \t\tint len;\n173\t// \t\t//将电机回传数据使用串口发送到VOFA，使用firewater协议\n174\t// \t\tif((current_time - foot_uart_last_time) > 100)\n175\t// \t\t{\n176\t//\n177\t//\n178\t// \t\tlen = sprintf(buffer, \"%lf,%lf,%lf,%lf,%lf,%lf\\n\",\n179\t// \t\t\tmotor_angle_DM_inside,motor_angle_DM_outside,\n180\t// \t\t\tmotor_angle_raw_inside,motor_angle_raw_outside,\n181\t// \t\t\tX,Y);\n182\t// \t\tHAL_UART_Transmit(huart, (uint8_t *)buffer, len, 1000);\n183\t// \t\tfoot_uart_last_time = HAL_GetTick();\n184\t// \t\t}\n185\t//\n186\t//\n187\t// }\n188"
