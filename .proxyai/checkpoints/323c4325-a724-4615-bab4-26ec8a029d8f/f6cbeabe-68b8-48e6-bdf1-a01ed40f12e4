         HAL_StatusTypeDef send_status,\n                                   uint32_t tx_free_level) {\n  manage_object->Status.Last_Tx_Free_Level = tx_free_level;\n  if (send_status == HAL_OK) {\n    manage_object->Status.Tx_Success_Count++;\n    manage_object->Status.Tx_Consecutive_Fail_Count = 0;\n  } else {\n    manage_object->Status.Tx_Fail_Count++;\n    manage_object->Status.Tx_Consecutive_Fail_Count++;\n    if (tx_free_level == 0U) {\n      manage_object->Status.Tx_Fifo_Full_Count++;\n    }\n  }\n}\n```\n\n---\n\n### 8. CAN RX (RECEIVE) CODE — Interrupt Callbacks\n\n**`drv_can.cpp` — `HAL_CAN_RxFifo0Callback()` (lines 300-324):**\n```c\nvoid HAL_CAN_RxFifo0Callback(CAN_HandleTypeDef *hcan, uint32_t RxFifo0ITs) {\n  if ((RxFifo0ITs & CAN_IT_RX_FIFO0_MSG_PENDING) == RESET) return;\n\n  // Determine CAN1 vs CAN2\n  if(hcan->Instance == CAN1) manager_obj = &CAN1_Manage_Object;\n  else if(hcan->Instance == CAN2) manager_obj = &CAN2_Manage_Object;\n  else return;\n\n  HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0,\n      &manager_obj->Rx_Buffer.Header, manager_obj->Rx_Buffer.Data);\n\n  if (!init_finished) return;\n  // Upper-layer callback\n  if(manager_obj->Callback_Function != nullptr)\n    manager_obj->Callback_Function(&manager_obj->Rx_Buffer);\n}\n```\n\n**`drv_can.cpp` — `HAL_CAN_RxFifo1Callback()` (lines 331-355):** Same pattern for FIFO1.\n\n**RX Buffer structure (`drv_can.h` lines 42-46):**\n```c\ntypedef struct {\n    CAN_RxHeaderTypeDef Header;\n    uint8_t Data[8];\n} Struct_CAN_Rx_Buffer;\n```\n\n**Callback type (`drv_can.h` line 52):**\n```c\ntypedef void (*CAN_Call_Back)(Struct_CAN_Rx_Buffer *rx_buffer);\n```\n\n---\n\n### 9. CAN ERROR HANDLING\n\n**`drv_can.cpp` — `HAL_CAN_ErrorStatusCallback()` (lines 363-395):**\n```c\nvoid HAL_CAN_ErrorStatusCallback(CAN_HandleTypeDef *hcan, uint32_t ErrorStatusITs) {\n  Struct_CAN_Manage_Object *manage_object = CAN_Get_Manage_Object(hcan);\n  if (manage_object != nullptr)\n    manage_object->Status.Last_Error_Status = ErrorStatusITs;\n\n  // Warning/Passive → update status\n  if ((ErrorStatusITs & (CAN_IT_ERROR_WARNING | CAN_IT_ERROR_PASSIVE)) != 0U)\n    CAN_Update_Bus_Status(hcan);\n\n  // Bus-Off → stop, restart, re-enable notifications\n  if ((ErrorStatusITs & CAN_IT_BUSOFF) != 0U) {\n    if (manage_object != nullptr)\n      manage_object->Status.Bus_Off_Count++;\n    HAL_CAN_Stop(hcan);\n    if (HAL_CAN_Start(hcan) == HAL_OK) {\n      HAL_CAN_ActivateNotification(hcan,\n          CAN_IT_RX_FIFO0_MSG_PENDING | CAN_IT_RX_FIFO1_MSG_PENDING |\n          CAN_IT_ERROR_WARNING | CAN_IT_ERROR_PASSIVE | CAN_IT_BUSOFF);\n    }\n  }\n  CAN_Update_Bus_Status(hcan);\n}\n```\n\n---\n\n### 10. CAN STATUS REGISTER CHECKS (Bus Status)\n\n**`drv_can.cpp` — `CAN_Update_Bus_Status()` (lines 231-266):**\n\nReads **MSR** (Mode Status Register) and **ESR** (Error Status Register) directly from the CAN peripheral registers:\n\n```c\nvoid CAN_Update_Bus_Status(CAN_HandleTypeDef *hcan) {\n  uint32_t msr = hcan->Instance->MSR;   // Mode Status Register\n  uint32_t esr = hcan->Instance->ESR;   // Error Status Register\n\n  // bit[0:2]: Last Error Code (LEC)\n  manage_object->Status.Last_Protocol_Status |= (esr & 0x7U);\n  // bit[6]: SLAK (Sleep Acknowledge)\n  manage_object->Status.Last_Protocol_Status |= ((((msr >> 1) & 0x1U)) << 6);\n  // bit[7]: INAK (Init Acknowledge)\n  manage_object->Status.Last_Protocol_Status |= ((((msr >> 0) & 0x1U)) << 7);\n  // bit[8]: Error Passive (EP)\n  manage_object->Status.Last_Protocol_Status |= ((((esr >> 4) & 0x1U)) << 8);\n  // bit[9]: Error Warning (EWGF)\n  manage_object->Status.Last_Protocol_Status |= ((((esr >> 2) & 0x1U)) << 9);\n  // bit[10]: Bus-Off (BS)\n  manage_object->Status.Last_Protocol_Status |= ((((msr >> 2) & 0x1U)) << 10);\n\n  manage_object->Status.Last_Error_Status = HAL_CAN_GetError(hcan);\n  manage_object->Status.Last_Tx_Free_Level = HAL_CAN_GetTxMailboxesFreeLevel(hcan);\n}\n```\n\n---\n\n### 11. CAN MANAGEMENT OBJECT STRUCTURES\n\n**`drv_can.h` (lines 42-81):**\n```c\ntypedef struct {\n    CAN_RxHeaderTypeDef Header;\n    uint8_t Data[8];\n} Struct_CAN_Rx_Buffer;\n\ntypedef void (*CAN_Call_Back)(Struct_CAN_Rx_Buffer *rx_buffer);\n\ntypedef struct {\n    uint32_t Tx_Success_Count;\n    uint32_t Tx_Fail_Count;\n    uint32_t Tx_Fifo_Full_Count;\n    uint32_t Tx_Consecutive_Fail_Count;\n    uint32_t Bus_Off_Count;\n    uint32_t Last_Tx_Free_Level;\n    uint32_t Last_Error_Status;\n    uint32_t Last_Protocol_Status;\n} Struct_CAN_Status;\n\ntypedef struct {\n    CAN_HandleTypeDef *CAN_Handler;\n    Struct_CAN_Rx_Buffer Rx_Buffer;\n    CAN_Call_Back Callback_Function;\n    Struct_CAN_Status Status;\n} Struct_CAN_Manage_Object;\n\nextern Struct_CAN_Manage_Object CAN1_Manage_Object;\nextern Struct_CAN_Manage_Object CAN2_Manage_Object;\n```\n\n---\n\n### 12. CAN TX BUFFERS (Pre-allocated per ID)\n\n**`drv_can.cpp` (lines 18-37):**\n```c\nuint8_t CAN_Supercap_Tx_Data[8];          // Supercapacitor\n\n// CAN1 TX buffers:\nuint8_t CAN1_0x1fe_Tx_Data[8], CAN1_0x1ff_Tx_Data[8], CAN1_0x200_Tx_Data[8];\nuint8_t CAN1_0x2fe_Tx_Data[8], CAN1_0x2ff_Tx_Data[8];\nuint8_t CAN1_0x3fe_Tx_Data[8], CAN1_0x4fe_Tx_Data[8];\n\n// CAN2 TX buffers:\nuint8_t CAN2_0x1fe_Tx_Data[8], CAN2_0x1ff_Tx_Data[8], CAN2_0x200_Tx_Data[8];\nuint8_t CAN2_0x2fe_Tx_Data[8], CAN2_0x2ff_Tx_Data[8];\nuint8_t CAN2_0x3fe_Tx_Data[8], CAN2_0x4fe_Tx_Data[8];\n```\n\n---\n\n### 13. CAN USAGE IN MOTOR CONTROL CODE\n\n**`Motor_DM.cpp/.h`** — DM (DaMiao) motor CAN protocol:\n\n- **`Class_Motor_DM_Normal::Init()`** (line 40) — Binds motor to CAN1 or CAN2 management object, sets CAN RX/TX IDs, control method, limits\n- **`Class_Motor_DM_Normal::CAN_RxCpltCallback()`** (line 216) — Called on CAN RX, processes motor data\n- **`Class_Motor_DM_Normal::CAN_Send_Enter/Exit/Clear_Error/Save_Zero()`** (lines 228-258) — Sends special DM command frames via `CAN_Send_Data()`\n- **`Class_Motor_DM_Normal::Output()`** (line 401) — Encodes MIT/Angle-Omega/Omega/EMIT control frame