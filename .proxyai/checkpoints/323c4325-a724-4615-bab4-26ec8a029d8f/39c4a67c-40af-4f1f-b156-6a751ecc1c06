                    "text": "1\t//\n2\t// Created by 24158 on 2026/6/7.\n3\t//\n4\t\n5\t#include \"Motor_DM.h\"\n6\t\n7\t/*传统DM模式（非类DJI一拖四）基本控制帧*/\n8\t//  清除电机错误信息，传统模式有效\n9\tuint8_t DM_Motor_CAN_Message_Clear_Error[8] = {\n10\t    0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xfb\n11\t};\n12\t\n13\t//  使能电机，传统模式有效\n14\tuint8_t DM_Motor_CAN_Message_Enter[8] = {\n15\t    0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xfc\n16\t};\n17\t\n18\t//  失能电机，传统模式有效\n19\tuint8_t DM_Motor_CAN_Message_Exit[8] = {\n20\t    0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xfd\n21\t};\n22\t\n23\t//  保存当前位置为零点，传统模式有效\n24\tuint8_t DM_Motor_CAN_Message_Save_Zero[8] = {\n25\t    0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xfe\n26\t};\n27\t\n28\t\n29\t/**\n30\t * @brief 电机初始化\n31\t *\n32\t * @param hcan 绑定的CAN总线\n33\t * @param __CAN_Rx_ID 收数据绑定的CAN ID, 与上位机驱动参数Master_ID保持一致, 传统模式有效\n34\t * @param __CAN_Tx_ID 发数据绑定的CAN ID, 是上位机驱动参数CAN_ID加上控制模式的偏移量, 传统模式有效\n35\t * @param __Motor_DM_Control_Method 电机控制方式\n36\t * @param __Angle_Max 最大位置, 与上位机控制幅度K_MAX保持一致, 传统模式有效\n37\t * @param __Omega_Max 最大速度, 与上位机控制幅度V_MAX保持一致, 传统模式有效\n38\t * @param __Torque_Max 最大扭矩, 与上位机控制幅度T_MAX保持一致, 传统模式有效\n39\t */\n40\tvoid Class_Motor_DM_Normal::Init(CAN_HandleTypeDef *hcan, uint16_t __CAN_Rx_ID, uint16_t __CAN_Tx_ID, Enum_Motor_DM_Control_Method __Motor_DM_Control_Method, float __Angle_Max, float __Omega_Max, float __Torque_Max, float __Current_Max)\n41\t{\n42\t    if (hcan->Instance == CAN1)\n43\t    {\n44\t        CAN_Manage_Object = &CAN1_Manage_Object;\n45\t    }\n46\t    else if (hcan->Instance == CAN2)\n47\t    {\n48\t        CAN_Manage_Object = &CAN2_Manage_Object;\n49\t    }\n50\t    else\n51\t    {\n52\t        CAN_Manage_Object = nullptr;  // CAN3不存在于STM32F4\n53\t    }\n54\t    CAN_Rx_ID = __CAN_Rx_ID;\n55\t\n56\t    switch (__Motor_DM_Control_Method)\n57\t    {\n58\t    case (Motor_DM_Control_Method_NORMAL_MIT):\n59\t        {\n60\t            CAN_Tx_ID = __CAN_Tx_ID;\n61\t            break;\n62\t        }\n63\t    case (Motor_DM_Control_Method_NORMAL_ANGLE_OMEGA):\n64\t        {\n65\t            CAN_Tx_ID = __CAN_Tx_ID + 0x100;\n66\t            break;\n67\t        }\n68\t    case (Motor_DM_Control_Method_NORMAL_OMEGA):\n69\t        {\n70\t            CAN_Tx_ID = __CAN_Tx_ID + 0x200;\n71\t            break;\n72\t        }\n73\t    case (Motor_DM_Control_Method_NORMAL_EMIT):\n74\t        {\n75\t            CAN_Tx_ID = __CAN_Tx_ID + 0x300;\n76\t            break;\n77\t        }\n78\t    }\n79\t    Motor_DM_Control_Method = __Motor_DM_Control_Method;\n80\t    Angle_Max = __Angle_Max;\n81\t    Omega_Max = __Omega_Max;\n82\t    Torque_Max = __Torque_Max;\n83\t    Current_Max = __Current_Max;\n84\t}\n85\t\n86\t/**\n87\t * @brief 分配CAN发送缓冲区, 一拖四模式有效\n88\t *\n89\t * @param hcan CAN编号\n90\t * @param __CAN_ID CAN ID\n91\t * @param __DJI_Motor_Driver_Version 大疆驱动版本, 当且仅当当前被分配电机为6020, 且是电流驱动新版本时选023, 否则都是default\n92\t * @return uint8_t* 缓冲区指针\n93\t */\n94\tuint8_t *allocate_tx_data(CAN_HandleTypeDef *hcan, Enum_Motor_DM_Motor_ID_1_To_4 __CAN_Rx_ID_1_To_4)\n95\t{\n96\t    uint8_t *tmp_tx_data_ptr;\n97\t    if (hcan->Instance == CAN1)\n98\t    {\n99\t        switch (__CAN_Rx_ID_1_To_4)\n100\t        {\n101\t        case (Motor_DM_ID_0x301):\n102\t        {\n103\t\n104\t\n105\t            break;\n106\t        }\n107\t        case (Motor_DM_ID_0x302):\n108\t        {\n109\t\n110\t\n111\t            break;\n112\t        }\n113\t        case (Motor_DM_ID_0x303):\n114\t        {\n115\t\n116\t\n117\t            break;\n118\t        }\n119\t        case (Motor_DM_ID_0x304):\n120\t        {\n121\t\n122\t\n123\t            break;\n124\t        }\n125\t        case (Motor_DM_ID_0x305):\n126\t        {\n127\t\n128\t\n129\t            break;\n130\t        }\n131\t        case (Motor_DM_ID_0x306):\n132\t        {\n133\t\n134\t\n135\t            break;\n136\t        }\n137\t        case (Motor_DM_ID_0x307):\n138\t        {\n139\t\n140\t\n141\t            break;\n142\t        }\n143\t        case (Motor_DM_ID_0x308):\n144\t        {\n145\t\n146\t\n147\t            break;\n148\t        }\n149\t        }\n150\t    }\n151\t    else if (hcan->Instance == CAN2)\n152\t    {\n153\t        switch (__CAN_Rx_ID_1_To_4)\n154\t        {\n155\t        case (Motor_DM_ID_0x301):\n156\t        {\n157\t\n158\t\n159\t            break;\n160\t        }\n161\t        case (Motor_DM_ID_0x302):\n162\t        {\n163\t\n164\t\n165\t            break;\n166\t        }\n167\t        case (Motor_DM_ID_0x303):\n168\t        {\n169\t\n170\t\n171\t            break;\n172\t        }\n173\t        case (Motor_DM_ID_0x304):\n174\t        {\n175\t\n176\t\n177\t            break;\n178\t        }\n179\t        case (Motor_DM_ID_0x305):\n180\t        {\n181\t\n182\t\n183\t            break;\n184\t        }\n185\t        case (Motor_DM_ID_0x306):\n186\t        {\n187\t\n188\t\n189\t            break;\n190\t        }\n191\t        case (Motor_DM_ID_0x307):\n192\t        {\n193\t\n194\t\n195\t            break;\n196\t        }\n197\t        case (Motor_DM_ID_0x308):\n198\t        {\n199\t\n200\t\n201\t            break;\n202\t        }\n203\t        }\n204\t    }\n205\t\n206\t\n207\t    return (tmp_tx_data_ptr);\n208\t}\n209\t\n210\t\n211\t/**\n212\t * @brief CAN通信接收回调函数\n213\t *\n214\t * @param Rx_Data 接收的数据\n215\t */\n216\tvoid Class_Motor_DM_Normal::CAN_RxCpltCallback(uint8_t *Rx_Data)\n217\t{\n218\t    // 滑动窗口, 判断电机是否在线\n219\t    Flag += 1;\n220\t\n221\t    Data_Process();\n222\t}\n223\t\n224\t/**\n225\t * @brief 发送清除错误信息\n226\t *\n227\t */\n228\tvoid Class_Motor_DM_Normal::CAN_Send_Clear_Error()\n229\t{\n230\t    CAN_Send_Data(CAN_Manage_Object->CAN_Handler, CAN_Tx_ID, DM_Motor_CAN_Message_Clear_Error, 8);\n231\t}\n232\t\n233\t/**\n234\t * @brief 发送使能电机\n235\t *\n236\t */\n237\tvoid Class_Motor_DM_Normal::CAN_Send_Enter()\n238\t{\n239\t    CAN_Send_Data(CAN_Manage_Object->CAN_Handler, CAN_Tx_ID, DM_Motor_CAN_Message_Enter, 8);\n240\t}\n241\t\n242\t/**\n243\t * @brief 发送失能电机\n244\t *\n245\t */\n246\tvoid Class_Motor_DM_Normal::CAN_Send_Exit()\n247\t{\n248\t    CAN_Send_Data(CAN_Manage_Object->CAN_Handler, CAN_Tx_ID, DM_Motor_CAN_Message_Exit, 8);\n249\t}\n250\t\n251\t/**\n252\t * @brief 发送保存当前位置为零点\n253\t *\n254\t */\n255\tvoid Class_Motor_DM_Normal::CAN_Send_Save_Zero()\n256\t{\n257\t    CAN_Send_Data(CAN_Manage_Object->CAN_Handler, CAN_Tx_ID, DM_Motor_CAN_Message_Save_Zero, 8);\n258\t}\n259\t\n260\t/**\n261\t * @brief TIM定时器中断定期检测电机是否存活, 检测周期取决于电机掉线时长\n262\t *\n263\t */\n264\tvoid Class_Motor_DM_Normal::RTOS_100ms_Alive_Callback()\n265\t{\n266\t    // 判断该时间段内是否接收过电机数据\n267\t    if (Flag == Pre_Flag)\n268\t    {\n269\t        // 电机断开连接\n270\t        Motor_DM_Status = Motor_DM_Status_DISABLE;\n271\t    }\n272\t    else\n273\t    {\n274\t        // 电机保持连接\n275\t        Motor_DM_Status = Motor_DM_Status_ENABLE;\n276\t    }\n277\t\n278\t    Pre_Flag = Flag;\n279\t}\n280\t\n281\t/**\n282\t * @brief TIM定时器中断发送出去的回调函数, 计算周期取决于自主设置的控制周期\n283\t *\n284\t */\n285\tvoid Class_Motor_DM_Normal::RTOS_Send_Callback()\n286\t{\n287\t    if (Rx_Data.Control_Status == Motor_DM_Status_ENABLE)\n288\t    {\n289\t        // 电机在线, 正常控制\n290\t        Math_Constrain(&Control_Angle, -Angle_Max, Angle_Max);\n291\t        Math_Constrain(&Control_Omega, -Omega_Max, Omega_Max);\n292\t        Math_Constrain(&Control_Torque, -Torque_Max, Torque_Max);\n293\t        Math_Constrain(&Control_Current, -Current_Max, Current_Max);\n294\t        Math_Constrain(&K_P, 0.0f, 500.0f);\n295\t        Math_Constrain(&K_D, 0.0f, 5.0f);\n296\t\n297\t        Output();\n298\t    }\n299\t    else if (Rx_Data.Control_Status == Motor_DM_Status_DISABLE)\n300\t    {\n301\t        // 电机可能掉线, 使能电机\n302\t        CAN_Send_Enter();\n303\t    }\n304\t    else\n305\t    {\n306\t        // 电机错误, 发送清除错误帧\n307\t        CAN_Send_Clear_Error();\n308\t    }\n309\t}\n310\t\n311\t/**\n312\t * @brief RC机器狗电机回调控制函数\n313\t *\n314\t */\n315\tvoid Class_Motor_DM_Normal::Dog_Send_Callback()\n316\t{\n317\t    if (Rx_Data.Control_Status == Motor_DM_Status_ENABLE)\n318\t    {\n319\t        // 电机在线, 正常控制\n320\t        Math_Constrain(&Control_Angle, -Angle_Max, Angle_Max);\n321\t        Math_Constrain(&Control_Omega, -Omega_Max, Omega_Max);\n322\t        Math_Constrain(&Control_Torque, -Torque_Max, Torque_Max);\n323\t        Math_Constrain(&Control_Current, -Current_Max, Current_Max);\n324\t        Math_Constrain(&K_P, 0.0f, 500.0f);\n325\t        Math_Constrain(&K_D, 0.0f, 5.0f);\n326\t\n327\t        Output();\n328\t    }\n329\t    else if (Rx_Data.Control_Status == Motor_DM_Status_DISABLE)\n330\t    {\n331\t        // 电机可能掉线, 使能电机\n332\t        CAN_Send_Enter();\n333\t    }\n334\t    else\n335\t    {\n336\t        // 电机错误, 发送清除错误帧\n337\t        CAN_Send_Clear_Error();\n338\t    }\n339\t}\n340\t\n341\t/**\n342\t * @brief 数据处理过程\n343\t *\n344\t */\n345\tvoid Class_Motor_DM_Normal::Data_Process()\n346\t{\n347\t // 数据处理过程\n348\t    int32_t delta_encoder;\n349\t    uint16_t tmp_encoder, tmp_omega, tmp_torque;\n350\t    Struct_Motor_DM_CAN_Rx_Data_Normal *tmp_buffer = (Struct_Motor_DM_CAN_Rx_Data_Normal *)CAN_Manage_Object->Rx_Buffer.Data;\n351\t\n352\t    // 电机ID不匹配, 则不进行处理\n353\t    if(tmp_buffer->CAN_ID != (CAN_Tx_ID & 0x0f))\n354\t    {\n355\t        return;\n356\t    }\n357\t\n358\t    // 处理大小端\n359\t    Math_Endian_Reverse_16((void *)&tmp_buffer->Angle_Reverse, &tmp_encoder);\n360\t    tmp_omega = (tmp_buffer->Omega_11_4 << 4) | (tmp_buffer->Omega_3_0_Torque_11_8 >> 4);\n361\t    tmp_torque = ((tmp_buffer->Omega_3_0_Torque_11_8 & 0x0f) << 8) | (tmp_buffer->Torque_7_0);\n362\t\n363\t    Rx_Data.Control_Status = static_cast<Enum_Motor_DM_Control_Status_Normal>(tmp_buffer->Control_Status_Enum);\n364\t\n365\t\t\tif (Rx_Data.First_Frame)\n366\t    {\n367\t        Rx_Data.Pre_Encoder = tmp_encoder;\n368\t        Rx_Data.Total_Round = 0;\n369\t        Rx_Data.First_Frame = false; // 之后不再进入此分支\n370\t    }\n371\t\n372\t    // 计算圈数与总角度值\n373\t    delta_encoder = tmp_encoder - Rx_Data.Pre_Encoder;\n374\t    if (delta_encoder < -(1 << 15))\n375\t    {\n376\t        // 正方向转过了一圈\n377\t        Rx_Data.Total_Round++;\n378\t    }\n379\t    else if (delta_encoder > (1 << 15))\n380\t    {\n381\t        // 反方向转过了一圈\n382\t        Rx_Data.Total_Round--;\n383\t    }\n384\t    Rx_Data.Total_Encoder = (Rx_Data.Total_Round << 16) + tmp_encoder;\n385\t\n386\t    // 计算电机本身信息\n387\t    Rx_Data.Now_Angle = ((float)(Rx_Data.Total_Encoder) / (float)(1 << 16))* 2.0f * Angle_Max;\n388\t    Rx_Data.Now_Omega = Math_Int_To_Float(tmp_omega, 0x7ff, (1 << 12) - 1, 0, Omega_Max);\n389\t    Rx_Data.Now_Torque = Math_Int_To_Float(tmp_torque, 0x7ff, (1 << 12) - 1, 0, Torque_Max);\n390\t    Rx_Data.Now_MOS_Temperature = tmp_buffer->MOS_Temperature + CELSIUS_TO_KELVIN;\n391\t    Rx_Data.Now_Rotor_Temperature = tmp_buffer->Rotor_Temperature + CELSIUS_TO_KELVIN;\n392\t\n393\t    // 存储预备信息\n394\t    Rx_Data.Pre_Encoder = tmp_encoder;\n395\t}\n396\t\n397\t/**\n398\t * @brief 电机数据输出到CAN总线\n399\t *\n400\t */\n401\tvoid Class_Motor_DM_Normal::Output()\n402\t{\n403\t    // 电机控制\n404\t    switch (Motor_DM_Control_Method)\n405\t    {\n406\t    case (Motor_DM_Control_Method_NORMAL_MIT):\n407\t    {\n408\t        Struct_Motor_DM_CAN_Tx_Data_Normal_MIT *tmp_buffer = (Struct_Motor_DM_CAN_Tx_Data_Normal_MIT *)Tx_Data;\n409\t\n410\t        uint16_t tmp_angle, tmp_omega, tmp_torque, tmp_k_p, tmp_k_d;\n411\t\n412\t        tmp_angle = Math_Float_To_Int(Control_Angle, 0, Angle_Max, 0x7fff, (1 << 16) - 1);\n413\t        tmp_omega = Math_Float_To_Int(Control_Omega, 0, Omega_Max, 0x7ff, (1 << 12) - 1);\n414\t        tmp_torque = Math_Float_To_Int(Control_Torque, 0, Torque_Max, 0x7ff, (1 << 12) - 1);\n415\t        tmp_k_p = Math_Float_To_Int(K_P, 0, 500.0f, 0, (1 << 12) - 1);\n416\t        tmp_k_d = Math_Float_To_Int(K_D, 0, 5.0f, 0, (1 << 12) - 1);\n417\t\n418\t        tmp_buffer->Control_Angle_Reverse = Math_Endian_Reverse_16(&tmp_angle, nullptr);\n419\t        tmp_buffer->Control_Omega_11_4 = tmp_omega >> 4;\n420\t        tmp_buffer->Control_Omega_3_0_K_P_11_8 = ((tmp_omega & 0x0f) << 4) | (tmp_k_p >> 8);\n421\t        tmp_buffer->K_P_7_0 = tmp_k_p & 0xff;\n422\t        tmp_buffer->K_D_11_4 = tmp_k_d >> 4;\n423\t        tmp_buffer->K_D_3_0_Control_Torque_11_8 = ((tmp_k_d & 0x0f) << 4) | (tmp_torque >> 8);\n424\t        tmp_buffer->Control_Torque_7_0 = tmp_torque & 0xff;\n425\t\n426\t        CAN_Send_Data(CAN_Manage_Object->CAN_Handler, CAN_Tx_ID, Tx_Data, 8);\n427\t\n428\t        break;\n429\t    }\n430\t    case (Motor_DM_Control_Method_NORMAL_ANGLE_OMEGA):\n431\t    {\n432\t        Struct_Motor_DM_CAN_Tx_Data_Normal_Angle_Omega *tmp_buffer = (Struct_Motor_DM_CAN_Tx_Data_Normal_Angle_Omega *)Tx_Data;\n433\t\n434\t        tmp_buffer->Control_Angle = Control_Angle;\n435\t        tmp_buffer->Control_Omega = Control_Omega;\n436\t\n437\t        CAN_Send_Data(CAN_Manage_Object->CAN_Handler, CAN_Tx_ID, Tx_Data, 8);\n438\t\n439\t        break;\n440\t    }\n441\t    case (Motor_DM_Control_Method_NORMAL_OMEGA):\n442\t    {\n443\t        Struct_Motor_DM_CAN_Tx_Data_Normal_Omega *tmp_buffer = (Struct_Motor_DM_CAN_Tx_Data_Normal_Omega *)Tx_Data;\n444\t\n445\t        tmp_buffer->Control_Omega = Control_Omega;\n446\t\n447\t        CAN_Send_Data(CAN_Manage_Object->CAN_Handler, CAN_Tx_ID, Tx_Data, 4);\n448\t\n449\t        break;\n450\t    }\n451\t    case (Motor_DM_Control_Method_NORMAL_EMIT):\n452\t    {\n453\t        Struct_Motor_DM_CAN_Tx_Data_Normal_EMIT *tmp_buffer = (Struct_Motor_DM_CAN_Tx_Data_Normal_EMIT *)Tx_Data;\n454\t\n455\t        tmp_buffer->Control_Angle = Control_Angle;\n456\t        tmp_buffer->Control_Omega = (uint16_t)(Control_Omega * 100.0f);\n457\t        tmp_buffer->Control_Current = (uint16_t)(Control_Current / Current_Max * 10000.0f);\n458\t\n459\t        CAN_Send_Data(CAN_Manage_Object->CAN_Handler, CAN_Tx_ID, Tx_Data, 8);\n460\t\n461\t        break;\n462\t    }\n463\t    }\n464\t}\n465\t\n466\t/**\n467\t * @brief 电机初始化\n468\t *\n469\t * @param hcan 绑定的CAN总线\n470\t * @param __CAN_Rx_ID 绑定的CAN ID\n471\t * @param __Motor_DM_Control_Method 电机控制方式, 默认角度\n472\t * @param __Encoder_Offset 编码器偏移, 默认0\n473\t * @param __Current_Max 最大电流\n474\t */\n475\tvoid Class_Motor_DM_1_To_4::Init(CAN_HandleTypeDef *hcan, Enum_Motor_DM_Motor_ID_1_To_4 __CAN_Rx_ID, Enum_Motor_DM_Control_Method __Motor_DM_Control_Method, int32_t __Encoder_Offset, float __Current_Max)\n476\t{\n477\t    if (hcan->Instance == CAN1)\n478\t    {\n479\t        CAN_Manage_Object = &CAN1_Manage_Object;\n480\t    }\n481\t    else if (hcan->Instance == CAN2)\n482\t    {\n483\t        CAN_Manage_Object = &CAN2_Manage_Object;\n484\t    }\n485\t    else\n486\t    {\n487\t        CAN_Manage_Object = nullptr;\n488\t    }\n489\t    CAN_Rx_ID = __CAN_Rx_ID;\n490\t    Motor_DM_Control_Method = __Motor_DM_Control_Method;\n491\t    Encoder_Offset = __Encoder_Offset;\n492\t    Current_Max = __Current_Max;\n493\t    Tx_Data = allocate_tx_data(hcan, __CAN_Rx_ID);\n494\t}\n495\t\n496\t/**\n497\t * @brief CAN通信接收回调函数\n498\t *\n499\t * @param Rx_Data 接收的数据\n500\t */\n501\tvoid Class_Motor_DM_1_To_4::CAN_RxCpltCallback(uint8_t *Rx_Data)\n502\t{\n503\t    // 滑动窗口, 判断电机是否在线\n504\t    Flag += 1;\n505\t\n506\t    Data_Process();\n507\t}\n508\t\n509\t/**\n510\t * @brief TIM定时器中断定期检测电机是否存活\n511\t *\n512\t */\n513\tvoid Class_Motor_DM_1_To_4::RTOS_100ms_Alive_Callback()\n514\t{\n515\t    // 判断该时间段内是否接收过电机数据\n516\t    if (Flag == Pre_Flag)\n517\t    {\n518\t        // 电机断开连接\n519\t        Motor_DM_Status = Motor_DM_Status_DISABLE;\n520\t        PID_Angle.Set_Integral_Error(0.0f);\n521\t        PID_Omega.Set_Integral_Error(0.0f);\n522\t    }\n523\t    else\n524\t    {\n525\t        // 电机保持连接\n526\t        Motor_DM_Status = Motor_DM_Status_ENABLE;\n527\t    }\n528\t    Pre_Flag = Flag;\n529\t}\n530\t\n531\t/**\n532\t * @brief TIM定时器中断计算回调函数, 计算周期取决于电机反馈周期\n533\t *\n534\t */\n535\tvoid Class_Motor_DM_1_To_4::RTOS_Calculate_Callback()\n536\t{\n537\t    PID_Calculate();\n538\t\n539\t    float tmp_value = Target_Current + Feedforward_Current;\n540\t   